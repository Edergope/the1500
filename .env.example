# Staging ONLY. Never commit live keys or real bank information.
# Local dev: copy to .dev.vars. Deployed: `npx wrangler secret put NAME` for every secret below.

# Public origin, used for links, webhooks return URLs and JSON-LD identifiers.
PUBLIC_BASE_URL=https://example.invalid
PUBLIC_INDEXING_ENABLED=false

# Email. Without these, sign-in returns 503 and notifications stay queued.
MAIL_FROM="THE1500 <signin@example.invalid>"
RESEND_API_KEY=

# Payments. Stay off until seller, Stripe account and tests are validated. Live keys (sk_live_) are refused in code.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI. Empty key means AI off: profiles stay in the owner's words and /ask answers from retrieval only, both labelled.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
