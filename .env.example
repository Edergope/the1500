# Staging ONLY. Never commit live keys or real bank information.
PAYMENTS_ENABLED=false
SELLER_LEGAL_ENTITY=PENDING
CHECKOUT_PROVIDER=stripe_pending
AI_PROVIDER=none
# Authentication emails are disabled unless these are configured with secure secrets.
# Use `npx wrangler secret put RESEND_API_KEY`, not plaintext in source control.
PUBLIC_BASE_URL=https://example.invalid
MAIL_FROM="THE1500 <signin@example.invalid>"
RESEND_API_KEY=

# Do not index staging or incomplete legal/commercial pages.
PUBLIC_INDEXING_ENABLED=false
