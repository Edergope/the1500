{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "astro/client"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/env.d.ts",
    "src/core/**/*.ts",
    "src/lib/**/*.ts",
    "src/pages/**/*.ts",
    "src/worker.ts",
    "src/middleware.ts"
  ]
}