{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": ".core-js-tests"
  },
  "include": [
    "src/core/**/*.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "src/core/http.ts"
  ]
}