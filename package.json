{
  "name": "the1500",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:db": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:types:isolated": "tsc -p tsconfig.core-check.json",
    "test:core:runtime": "tsc -p tsconfig.core-runtime-test.json && node -e \"require('fs').writeFileSync('.core-js-tests/package.json', JSON.stringify({type:'commonjs'}))\" && node --test --test-concurrency=1 tests/integration/*.test.cjs",
    "test:local": "npm run test:db && npm run test:types:isolated && npm run test:core:runtime",
    "test:e2e": "astro build && node tests/e2e/journey.cjs",
    "demo:seed:local": "node scripts/demo.cjs seed --target local",
    "test:remote": "node tests/remote/staging.cjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/react": "^7.1.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.125.0"
  }
}
