---
import type { Locale } from '../lib/contracts/api';
import type { HomeData } from '../core/home';
import HomeRegister from './HomeRegister';
import DiscoveryHub from './DiscoveryHub';
import { formatPosition, formatUsdCents } from '../ui/i18n';
import { phaseBreakdown } from '../ui/register';
import '../styles/home.css';

interface Props {
  lang: Locale;
  data: HomeData;
}

const { lang, data } = Astro.props;
const { stats, businesses, totalPublished, retiredPositions, positionMap, retiredLabel, sample } = data;
const es = lang === 'es';
const prefix = es ? '/es' : '';
const closed = stats?.salesMode === 'closed_archive';
const number = (n: number) => n.toLocaleString(es ? 'de-DE' : 'en-US');
const shownCompanies = businesses.slice(0, 6);

const steps = es
  ? [
      ['Únete o recibe una invitación', 'Registra tu empresa con tu correo corporativo y asegura una posición en la fase abierta.'],
      ['Cuéntanos qué hace tu empresa', 'Describe tus servicios, a quién atiendes y qué problemas resuelves.'],
      ['Revisa el perfil', 'Preparamos un perfil estructurado y te mostramos exactamente lo que se publicará.'],
      ['Apruébalo y publícalo', 'Nada se publica sin tu aprobación expresa. Recibes una página pública y tus datos estructurados.'],
      ['Aparece en THE1500', 'Tu empresa entra en el directorio, en su buscador y en su asistente.'],
    ]
  : [
      ['Join or get invited', 'Register your company with your work email and secure a position in the open phase.'],
      ['Tell us what your company does', 'Describe your services, who you serve and the problems you solve.'],
      ['Review the profile', 'We prepare a structured profile and show you exactly what will be published.'],
      ['Approve and publish', 'Nothing goes live without your explicit approval. You get a public page and your structured data.'],
      ['Appear in THE1500', 'Your company joins the directory, its search and its assistant.'],
    ];

const promises = es
  ? [
      'Una posición numerada dentro de un máximo de 1.500.',
      'Publicación garantizada 12 meses desde la primera publicación, según las condiciones aplicables.',
      '15 días tras publicar para hacer correcciones iniciales.',
      'Una página pública bilingüe y tus datos en un formato estándar que puedes exportar.',
      'Presencia en el buscador y el asistente de THE1500.',
    ]
  : [
      'A numbered position, out of a maximum of 1,500.',
      'Publication guaranteed for 12 months from first publication, under the applicable conditions.',
      '15 days after publishing to make initial corrections.',
      'A bilingual public page, and your data in a standard format you can export.',
      'A place in THE1500’s own search and assistant.',
    ];

const limits = es
  ? [
      'Ningún tercero puede garantizar lo que digan ChatGPT, Gemini, Claude u otros sistemas externos, y nosotros tampoco.',
      'THE1500 no certifica las empresas: la información la declara y aprueba cada titular.',
      'Conservar los perfiles 10 años es un objetivo técnico, no un compromiso contractual.',
    ]
  : [
      'No third party can guarantee what ChatGPT, Gemini, Claude or other external systems say, and neither do we.',
      'THE1500 does not certify companies: each owner declares and approves its own information.',
      'Keeping profiles for 10 years is a technical goal, not a contractual promise.',
    ];

const faqs = es
  ? [
      ['¿Cuándo recibe mi empresa su número?', 'Al confirmarse el pago, en orden ascendente. Una reserva de 20 minutos guarda capacidad, pero no asigna un número, y los números no se pueden elegir.'],
      ['¿Qué pasa si una empresa publicada se retira?', 'Su identidad desaparece de todas las superficies públicas y la posición queda retirada de forma permanente. No vuelve a venderse.'],
      ['¿Se publica algo sin mi aprobación?', 'Nunca. No responder no cuenta como aprobar: un representante autorizado debe aprobar el contenido exacto antes de publicarlo.'],
      ['¿Qué son las posiciones reservadas para fundadores?', 'Las posiciones 1 a 100 se asignan solo por invitación y no están a la venta. Las empresas que compran reciben posiciones desde la 101.'],
      ['¿Por qué cambia el precio?', 'Hay cuatro fases con precio fijo. Cuando una se completa, abre la siguiente a su precio. Los precios son base, antes de los impuestos aplicables.'],
    ]
  : [
      ['When does my company get its number?', 'When payment is confirmed, in ascending order. A 20-minute hold keeps capacity but assigns no number, and numbers cannot be chosen.'],
      ['What happens if a published company withdraws?', 'Its identity is removed from every public surface and the position is permanently retired. It is never sold again.'],
      ['Is anything published without my approval?', 'Never. Not responding does not count as approval: an authorized representative must approve the exact content before it goes live.'],
      ['What are the positions reserved for founders?', 'Positions 1 to 100 are allocated by invitation only and are not for sale. Companies that buy receive positions from 101 onward.'],
      ['Why does the price change?', 'There are four phases, each at a fixed price. When one fills, the next opens at its price. Prices are base prices, before applicable tax.'],
    ];

const countryName = (code: string) => {
  try {
    return new Intl.DisplayNames([lang], { type: 'region' }).of(code) || code;
  } catch {
    return code;
  }
};
const sampleIsDemo = sample ? sample.profile.name.toLowerCase().startsWith('demo ') : false;
---
<main class="home">
  <HomeRegister
    client:load
    lang={lang}
    stats={stats}
    businesses={businesses}
    positionMap={positionMap}
    retiredLabel={retiredLabel}
  />

  <section id="why" class="home-block two-readers" aria-labelledby="why-title">
    <div class="home-lead">
      <h2 id="why-title">{es ? 'Un perfil, dos lectores' : 'One profile, two readers'}</h2>
      <p>
        {es
          ? 'Cada vez más, tus clientes y los sistemas que usan intentan entender qué hace una empresa a partir de lo que encuentran publicado. Si esa información está dispersa o es genérica, tienen poco con qué trabajar. THE1500 la ordena en un solo perfil aprobado por ti.'
          : 'More and more, your customers and the systems they use try to work out what a company does from what they find published. If that information is scattered or generic, they have little to go on. THE1500 puts it into one profile you approve.'}
      </p>
    </div>

    {sample && (
      <div class="readers">
        <article class="reader reader-person">
          <p class="reader-tag">{es ? 'Lo que lee una persona' : 'What a person reads'}</p>
          <h3>{sample.profile.name}</h3>
          <p class="reader-meta">
            {formatPosition(sample.profile.position)}, {sample.profile.industry}, {countryName(sample.profile.country)}
            {sampleIsDemo && <span class="demo-tag">{es ? 'Demostración' : 'Demo'}</span>}
          </p>
          <p>{sample.profile.summary}</p>
          {sample.profile.problemSolutions[0] && (
            <dl>
              <dt>{es ? 'Problema' : 'Problem'}</dt>
              <dd>{sample.profile.problemSolutions[0].problem}</dd>
              <dt>{es ? 'Solución' : 'Solution'}</dt>
              <dd>{sample.profile.problemSolutions[0].solution}</dd>
            </dl>
          )}
        </article>
        <article class="reader reader-machine">
          <p class="reader-tag">{es ? 'Lo que lee el software' : 'What software reads'}</p>
          <pre tabindex="0"><code>{JSON.stringify(sample.machine, null, 2)}</code></pre>
        </article>
      </div>
    )}

    <div class="benefits">
      <div>
        <h3>{es ? 'Un lugar propio' : 'A place of your own'}</h3>
        <p>
          {es
            ? 'Una posición numerada en un directorio que nunca superará las 1.500 empresas. Una posición publicada no vuelve a venderse.'
            : 'A numbered position in a directory that will never exceed 1,500 companies. A published position is never sold again.'}
        </p>
      </div>
      <div>
        <h3>{es ? 'Tus palabras, tu aprobación' : 'Your words, your approval'}</h3>
        <p>
          {es
            ? 'Ves exactamente lo que se publicará y de dónde salió cada dato. Sin tu aprobación, nada sale.'
            : 'You see exactly what will be published and where each detail came from. Without your approval, nothing goes out.'}
        </p>
      </div>
      <div>
        <h3>{es ? 'Claridad, no posicionamiento' : 'Clarity, not rankings'}</h3>
        <p>
          {es
            ? 'Esto no es SEO: es presentar con claridad quién eres y qué resuelves. No garantizamos inclusión ni recomendación en plataformas externas de inteligencia artificial.'
            : 'This is not SEO: it is a clear account of who you are and what you solve. We do not guarantee inclusion or recommendation on external AI platforms.'}
        </p>
      </div>
    </div>
  </section>

  <section id="explore" class="home-block" aria-labelledby="explore-title">
    <div class="home-lead home-lead-split">
      <div>
        <h2 id="explore-title">{es ? 'Quién está ya en el registro' : 'Who is already in the register'}</h2>
        {shownCompanies.some((c) => c.name.toLowerCase().startsWith('demo ')) && (
          <p>
            {es
              ? 'Las empresas marcadas como demostración son ejemplos de prueba, no negocios reales.'
              : 'Companies marked as demo are test examples, not real businesses.'}
          </p>
        )}
      </div>
      <a class="btn-secondary" href={`${prefix}/empresas`}>
        {es ? `Ver las ${number(totalPublished)} empresas` : `View all ${number(totalPublished)} companies`}
      </a>
    </div>

    {shownCompanies.length > 0 ? (
      <ol class="roster">
        {shownCompanies.map((c) => (
          <li>
            <a href={`${prefix}/empresas/${c.slug}`}>
              <span class="roster-number">{formatPosition(c.position)}</span>
              <span class="roster-name">
                {c.name}
                {c.name.toLowerCase().startsWith('demo ') && <span class="demo-tag">{es ? 'Demostración' : 'Demo'}</span>}
              </span>
              <span class="roster-sector">{c.industry}</span>
              <span class="roster-country">{countryName(c.country)}</span>
            </a>
          </li>
        ))}
        {retiredPositions.slice(0, 1).map((position) => (
          <li class="roster-retired">
            <span class="roster-row">
              <span class="roster-number">{formatPosition(position)}</span>
              <span class="roster-name">{retiredLabel}</span>
            </span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-note">
        {es
          ? 'Aún no hay perfiles publicados. Las primeras empresas aparecerán aquí en cuanto sus titulares los aprueben.'
          : 'No profiles are published yet. The first companies will appear here as soon as their owners approve them.'}
      </p>
    )}

    <div class="discovery-wrap">
      <DiscoveryHub client:visible lang={lang} />
    </div>
  </section>

  <section id="how-it-works" class="home-block" aria-labelledby="how-title">
    <div class="home-lead">
      <h2 id="how-title">{es ? 'De la posición al perfil publicado' : 'From position to published profile'}</h2>
    </div>
    <ol class="steps">
      {steps.map(([title, text]) => (
        <li>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="pricing-phases" class="home-block" aria-labelledby="phases-title">
    <div class="home-lead">
      <h2 id="phases-title">{es ? 'Cuatro fases, un solo límite' : 'Four phases, one limit'}</h2>
      <p>
        {es
          ? 'El precio sube al completarse cada fase, así que quien entra antes paga menos. Precios base, antes de los impuestos aplicables.'
          : 'The price rises as each phase fills, so joining earlier costs less. Base prices, before applicable tax.'}
      </p>
    </div>

    {stats && positionMap ? (
      <ul class="phases">
        {stats.phases.map((phase) => {
          const parts = phaseBreakdown(positionMap, phase);
          const isCurrent = phase.status === 'current';
          const state =
            phase.phase === 4
              ? isCurrent
                ? es ? 'Abierta, por solicitud' : 'Open, by application'
                : phase.status === 'sold_out'
                  ? es ? 'Completa' : 'Full'
                  : es ? 'Futura, por solicitud' : 'Later, by application'
              : phase.status === 'sold_out'
                ? es ? 'Completa' : 'Full'
                : isCurrent
                  ? stats.checkoutOpen
                    ? es ? 'Abierta ahora' : 'Open now'
                    : es ? 'Venta en pausa' : 'Sales paused'
                  : es ? 'Futura' : 'Later';
          return (
            <li class:list={['phase', { 'phase-current': isCurrent }]}>
              <div class="phase-head">
                <span class="phase-name">{es ? 'Fase' : 'Phase'} {phase.phase}</span>
                <span class="phase-range">
                  {es ? 'Posiciones' : 'Positions'} {number(phase.firstPosition)}–{number(phase.lastPosition)}
                </span>
                <span class="phase-state">{state}</span>
              </div>
              <div class="phase-price">{formatUsdCents(phase.priceUsdCents, lang).replace(' USD', '')}<small>USD</small></div>
              <div class="phase-fill" aria-hidden="true">
                <span class="fill-gone" style={`flex-grow:${parts.gone}`}></span>
                <span class="fill-reserved" style={`flex-grow:${parts.reserved}`}></span>
                <span class="fill-open" style={`flex-grow:${parts.open}`}></span>
              </div>
              <p class="phase-note">
                {parts.reserved > 0 && (
                  <>
                    {es
                      ? `${number(parts.open)} en venta y ${number(parts.reserved)} reservadas para fundadores, por invitación.`
                      : `${number(parts.open)} for sale and ${number(parts.reserved)} reserved for founders, by invitation.`}
                  </>
                )}
                {parts.reserved === 0 && (
                  <>
                    {phase.phase === 4
                      ? es
                        ? `${number(parts.open)} posiciones por solicitud y revisión de una persona, sin pago en línea.`
                        : `${number(parts.open)} positions by application and human review, with no online checkout.`
                      : es
                        ? `${number(parts.open)} de ${number(parts.total)} posiciones libres.`
                        : `${number(parts.open)} of ${number(parts.total)} positions free.`}
                  </>
                )}
              </p>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="empty-note">
        {es ? 'La disponibilidad no se pudo cargar. Inténtalo de nuevo en unos minutos.' : 'Availability could not be loaded. Try again in a few minutes.'}
      </p>
    )}
  </section>

  <section id="trust-proof" class="home-block" aria-labelledby="promise-title">
    <div class="home-lead">
      <h2 id="promise-title">{es ? 'Lo que prometemos, y lo que no' : 'What we promise, and what we don’t'}</h2>
    </div>
    <div class="promises">
      <div>
        <h3>{es ? 'Recibes' : 'You get'}</h3>
        <ul>{promises.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h3>{es ? 'No prometemos' : 'We don’t promise'}</h3>
        <ul>{limits.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="faq" class="home-block" aria-labelledby="faq-title">
    <div class="home-lead">
      <h2 id="faq-title">{es ? 'Preguntas frecuentes' : 'Questions'}</h2>
    </div>
    <div class="faq">
      {faqs.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <h2 id="closing-title">
      {closed
        ? es ? 'Las 1.500 posiciones ya tienen dueño.' : 'All 1,500 positions are taken.'
        : es ? 'Cuando se asigne la última, se acabó.' : 'When the last one goes, that’s it.'}
    </h2>
    <div class="reg-cta">
      {!closed && (
        <a class="button btn-lg" href={`${prefix}/unirse`}>{es ? 'Unirse a THE1500' : 'Join THE1500'}</a>
      )}
      <a class={closed ? 'button btn-lg' : 'btn-secondary btn-lg'} href={`${prefix}/empresas`}>
        {es ? 'Ver directorio' : 'View Directory'}
      </a>
    </div>
    <p class="closing-signin">
      {es ? '¿Ya estás dentro?' : 'Already a member?'}
      <a href={`${prefix}/login`}>{es ? 'Iniciar sesión' : 'Sign in'}</a>
    </p>
  </section>

  <div class="mobile-cta">
    {!closed && <a class="button" href={`${prefix}/unirse`}>{es ? 'Unirse a THE1500' : 'Join THE1500'}</a>}
    <a class="btn-secondary" href={`${prefix}/empresas`}>{es ? 'Ver directorio' : 'View Directory'}</a>
  </div>
</main>
