---
import type { Locale } from '../lib/contracts/api';
import { formatPosition } from '../ui/i18n';

interface RetiredItem {
  position: number;
  label: string;
  labelEs: string;
}

interface Props {
  items: RetiredItem[];
  lang?: Locale;
}

const { items, lang = 'en' } = Astro.props;
const es = lang === 'es';
---
{items && items.length > 0 && (
  <section class="surface-card" aria-label={es ? 'Cupos retirados' : 'Retired positions'}>
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.85rem">
      <div>
        <h3 style="margin:0;font-size:1.05rem">
          {es ? 'Registro de cupos retirados definitivamente' : 'Permanently retired positions'}
        </h3>
        <p class="muted" style="margin:0.2rem 0 0 0;font-size:0.84rem">
          {es
            ? 'Un cupo publicado y posteriormente retirado queda consumido de forma permanente y no vuelve a ponerse a la venta.'
            : 'Once a published profile is withdrawn, its position is permanently consumed and never returns to sale.'}
        </p>
      </div>
      <span class="badge badge-red mono">{items.length}</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:0.65rem">
      {items.map((item) => (
        <div
          style="display:flex;align-items:center;justify-content:space-between;gap:0.65rem;padding:0.65rem 0.9rem;border-radius:var(--radius-sm);background:rgba(248,113,113,0.06);border:1px solid rgba(248,113,113,0.22)"
        >
          <span class="mono" style="font-weight:700;color:var(--red)">
            {formatPosition(item.position)}
          </span>
          <span style="font-size:0.82rem;color:var(--text-secondary)">
            {es ? item.labelEs : item.label}
          </span>
        </div>
      ))}
    </div>
  </section>
)}
