---
import type { Locale } from '../lib/contracts/api';
import type { JoinData, OfferState } from '../core/join';
import { formatPosition, formatUsdCents } from '../ui/i18n';
import { isDemoName, monogram, tileLook } from '../lib/mosaic';
import '../styles/home.css';
import '../styles/join.css';

interface Props {
  lang: Locale;
  data: JoinData;
}

const { lang, data } = Astro.props;
const { home, offer, priceUsdCents, openPositions, profile } = data;
const es = lang === 'es';
const prefix = es ? '/es' : '';
const number = (n: number) => n.toLocaleString(es ? 'de-DE' : 'en-US');
const account = `${prefix}/mi-cuenta`;
const directory = `${prefix}/empresas`;
const price = priceUsdCents !== null ? formatUsdCents(priceUsdCents, lang) : null;
const open = openPositions !== null ? number(openPositions) : null;

const countryName = (code: string) => {
  try {
    return new Intl.DisplayNames([lang], { type: 'region' }).of(code) || code;
  } catch {
    return code;
  }
};

/** One action per state. Each one goes where the backend will actually allow it. */
const actions: Record<OfferState, { label: string; href: string }> = {
  open: { label: es ? 'Registrar mi empresa y reservar' : 'Register and reserve', href: account },
  open_no_payment: { label: es ? 'Registrar mi empresa' : 'Register my company', href: account },
  paused: { label: es ? 'Registrar mi empresa' : 'Register my company', href: account },
  premium: { label: es ? 'Solicitar admisión' : 'Apply for admission', href: account },
  closed: { label: es ? 'Ver el directorio' : 'View the directory', href: directory },
  unknown: { label: es ? 'Volver a intentar' : 'Try again', href: `${prefix}/unirse` },
};
const action = actions[offer];

const offerCopy: Record<OfferState, { title: string; text: string }> = {
  open: {
    title: es ? 'Fase abierta ahora' : 'Open now',
    text: es
      ? 'Reservas tu lugar durante 20 minutos, pagas, y tu número se asigna al confirmarse el pago.'
      : 'You hold your place for 20 minutes, pay, and your number is assigned when payment is confirmed.',
  },
  open_no_payment: {
    title: es ? 'Fase abierta, pagos aún sin activar' : 'Open, with payment not active yet',
    text: es
      ? 'Este entorno de pruebas no acepta pagos y no se te cobrará nada. Puedes registrar tu empresa y preparar su información desde ahora.'
      : 'This test environment does not accept payment and you will not be charged. You can register your company and prepare its information now.',
  },
  paused: {
    title: es ? 'Venta en pausa' : 'Sales are paused',
    text: es
      ? 'Las posiciones en venta de esta fase se agotaron y la siguiente aún no abre. Puedes registrar tu empresa para tenerla lista. Registrarse no reserva una posición.'
      : 'The positions for sale in this release are gone and the next one is not open yet. You can register your company so it is ready. Registering does not hold a position.',
  },
  premium: {
    title: es ? 'Últimas posiciones, por solicitud' : 'Final positions, by application',
    text: es
      ? 'No hay pago en línea. Presentas tu solicitud desde tu cuenta y la revisa una persona. Solicitar no reserva una posición, y nunca se exige una reunión.'
      : 'There is no online payment. You apply from your account and a person reviews it. Applying holds no position, and a meeting is never required.',
  },
  closed: {
    title: es ? 'Las 1.500 posiciones están asignadas' : 'All 1,500 positions are taken',
    text: es
      ? 'Ya no se vende ninguna. El directorio, su buscador y su asistente siguen abiertos.'
      : 'None are for sale. The directory, its search and its assistant stay open.',
  },
  unknown: {
    title: es ? 'No pudimos cargar la disponibilidad' : 'Availability could not be loaded',
    text: es
      ? 'No mostramos precios ni cupos estimados. Inténtalo de nuevo en unos minutos.'
      : 'We never show estimated prices or availability. Try again in a few minutes.',
  },
};
const showsPrice = offer === 'open' || offer === 'open_no_payment' || offer === 'premium';

const process = es
  ? [
      ['Solicitud o adquisición', 'Registras tu empresa con tu correo corporativo y adquieres o solicitas tu lugar.', 'Tú'],
      ['Información empresarial', 'Nos cuentas qué haces, a quién atiendes y qué problemas resuelves.', 'Tú'],
      ['Preparación del perfil', 'Ordenamos esa información en un perfil bilingüe e indicamos de dónde salió cada dato.', 'THE1500'],
      ['Aprobación del titular', 'Revisas el contenido exacto. No responder no cuenta como aprobar.', 'Tú'],
      ['Publicación', 'Tu pieza se enciende en el muro y tu perfil entra en el directorio.', 'THE1500'],
    ]
  : [
      ['Application or purchase', 'You register your company with a work email and acquire or apply for your place.', 'You'],
      ['Company information', 'You tell us what you do, who you serve and the problems you solve.', 'You'],
      ['Profile preparation', 'We structure it into a bilingual profile that shows where each detail came from.', 'THE1500'],
      ['Owner approval', 'You review the exact content. Not responding does not count as approval.', 'You'],
      ['Publication', 'Your piece lights up on the wall and your profile enters the directory.', 'THE1500'],
    ];

const demo = profile ? profile[lang] : null;
const demoIsDemo = demo ? isDemoName(demo.name) : false;
const look = demo ? tileLook(demo.slug) : { color: { bg: '#1f43b0', ink: '#f5f2eb' }, variant: 0 };
const demoName = demo?.name ?? (es ? 'Tu empresa' : 'Your company');
const demoProblem = demo?.problemSolutions[0];
const machine = home.sample?.machine ?? { '@type': 'Organization', name: demoName };
const demoHref = demo ? demo.html : directory;

const tabs = es
  ? [
      ['position', 'Posición numerada', 'Un número del 1 al 1.500, y una pieza en el muro.'],
      ['page', 'Perfil público', 'Una página propia con lo que tu empresa hace y resuelve.'],
      ['bilingual', 'Página bilingüe', 'En inglés y español, con la misma información.'],
      ['data', 'Datos estructurados', 'En un formato estándar que el software lee y tú puedes exportar.'],
      ['search', 'Directorio y buscador', 'Te encuentran por el problema que resuelves.'],
      ['assistant', 'Asistente interno', 'Puede citar tu perfil publicado al responder.'],
      ['term', '12 meses de publicación', 'Garantizados desde la primera publicación, según las condiciones aplicables.'],
    ]
  : [
      ['position', 'A numbered position', 'A number from 1 to 1,500, and a piece on the wall.'],
      ['page', 'A public profile', 'A page of its own saying what your company does and solves.'],
      ['bilingual', 'A bilingual page', 'In English and Spanish, with the same information.'],
      ['data', 'Structured data', 'In a standard format that software reads and you can export.'],
      ['search', 'Directory and search', 'People find you by the problem you solve.'],
      ['assistant', 'Internal assistant', 'It can cite your published profile when it answers.'],
      ['term', '12 months of publication', 'Guaranteed from first publication, under the applicable conditions.'],
    ];

const clientJson = JSON.stringify({ map: home.positionMap, current: home.currentRange, position: demo?.position ?? null }).replace(/</g, '\\u003c');
---
<main class="home join">
  <section class="jn-hero" aria-labelledby="jn-title">
    <div class="jn-hero-wall" aria-hidden="true">
      <canvas class="jn-glass"></canvas>
      <div class="jn-hero-shade"></div>
      <div class="jn-piece">
        <span class="jn-piece-mark">1<small>/{es ? '1.500' : '1,500'}</small></span>
        <span class="jn-piece-name">{es ? 'Tu empresa' : 'Your company'}</span>
      </div>
    </div>
    <div class="jn-hero-copy">
      <h1 id="jn-title">{es ? 'Una de las 1.500 puede ser la tuya.' : 'One of the 1,500 could be yours.'}</h1>
      <p>
        {es
          ? 'THE1500 es un registro público que nunca tendrá más de 1.500 empresas. Tu empresa recibe una posición numerada y un perfil público, en inglés y español, que explica qué hace y qué resuelve, con contenido que tú apruebas.'
          : 'THE1500 is a public register that will never hold more than 1,500 companies. Yours gets a numbered position and a public profile, in English and Spanish, saying what it does and what it solves, with content you approve.'}
      </p>
      <a class="button btn-lg" href={action.href}>{action.label}</a>
    </div>
  </section>

  <canvas class="seam" data-a="#070b14" data-b="#14297a" aria-hidden="true" style="--a:#070b14;--b:#14297a"></canvas>

  <section class="jn-get" aria-labelledby="jn-get-title">
    <div class="wrap">
      <h2 id="jn-get-title" class="display">{es ? 'Qué recibe tu empresa' : 'What your company receives'}</h2>
      <div class="jn-demo" id="jn-demo" style={`--bg:${look.color.bg};--ink:${look.color.ink}`}>
        <div class="jn-tabs" role="tablist" aria-label={es ? 'Qué incluye' : 'What is included'}>
          {tabs.map(([id, title, text], i) => (
            <button type="button" role="tab" id={`jn-tab-${id}`} aria-controls={`jn-panel-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <strong>{title}</strong>
              <span>{text}</span>
            </button>
          ))}
        </div>
        <div class="jn-stage">
          <div class="jn-panels">
            <div class="jn-panel is-on" role="tabpanel" id="jn-panel-position" aria-labelledby="jn-tab-position">
              <div class="jn-position">
                <div class="jn-tile">
                  <b>{monogram(demoName)}</b>
                  <span>{demo ? formatPosition(demo.position) : '#----'}</span>
                </div>
                <canvas class="jn-mini" width="500" height="300" role="img" aria-label={es ? 'Las 1.500 posiciones, con esta empresa resaltada' : 'The 1,500 positions, with this company highlighted'}></canvas>
              </div>
              <p class="jn-caption">{es ? 'El número se asigna en orden al confirmarse el pago y no se elige.' : 'The number is assigned in order when payment is confirmed, and cannot be chosen.'}</p>
            </div>

            <div class="jn-panel" role="tabpanel" id="jn-panel-page" aria-labelledby="jn-tab-page">
              <p class="jn-url">{`the1500${demoHref}`.slice(0, 54)}</p>
              <h3 class="jn-serif">{demoName}</h3>
              {demo && <p class="jn-meta">{formatPosition(demo.position)}, {demo.industry}, {countryName(demo.country)}</p>}
              <p>{demo?.summary ?? (es ? 'Qué hace tu empresa, en palabras que tú apruebas.' : 'What your company does, in words you approve.')}</p>
              {demoProblem && <p class="jn-solves"><strong>{es ? 'Resuelve:' : 'Solves:'}</strong> {demoProblem.problem}</p>}
              {demo && <a class="jn-link" href={demoHref}>{es ? 'Abrir este perfil' : 'Open this profile'}</a>}
            </div>

            <div class="jn-panel" role="tabpanel" id="jn-panel-bilingual" aria-labelledby="jn-tab-bilingual">
              <div class="jn-two">
                <div>
                  <span class="jn-lang">English</span>
                  <p>{profile?.en.summary ?? 'What your company does, in words you approve.'}</p>
                </div>
                <div>
                  <span class="jn-lang">Español</span>
                  <p>{profile?.es.summary ?? 'Qué hace tu empresa, en palabras que tú apruebas.'}</p>
                </div>
              </div>
            </div>

            <div class="jn-panel" role="tabpanel" id="jn-panel-data" aria-labelledby="jn-tab-data">
              <pre tabindex="0"><code>{JSON.stringify(machine, null, 2)}</code></pre>
            </div>

            <div class="jn-panel" role="tabpanel" id="jn-panel-search" aria-labelledby="jn-tab-search">
              <p class="jn-query">{(demoProblem?.problem ?? (es ? 'el problema que resuelves' : 'the problem you solve')).slice(0, 60)}</p>
              <div class="jn-result">
                <span class="jn-result-mark">{monogram(demoName)}</span>
                <div>
                  <strong>{demoName}</strong>
                  <p>{demo?.summary}</p>
                </div>
              </div>
              <p class="jn-caption">{es ? 'Busca tus palabras en los perfiles publicados. No interpreta sinónimos.' : 'It searches for your words in published profiles. It does not interpret synonyms.'}</p>
            </div>

            <div class="jn-panel" role="tabpanel" id="jn-panel-assistant" aria-labelledby="jn-tab-assistant">
              <p class="jn-ask">{es ? '¿Quién puede ayudarme con esto?' : 'Who can help me with this?'}</p>
              <blockquote>«{demoProblem?.solution ?? demo?.summary ?? (es ? 'Una cita de tu perfil publicado.' : 'A quote from your published profile.')}»</blockquote>
              <p class="jn-cite">{es ? 'Cita de' : 'Quote from'} {demoName}</p>
              <p class="jn-caption">{es ? 'Ejemplo ilustrativo. El asistente solo responde con perfiles publicados, y se abstiene si no hay evidencia.' : 'Illustrative example. The assistant only answers from published profiles, and abstains without evidence.'}</p>
            </div>

            <div class="jn-panel" role="tabpanel" id="jn-panel-term" aria-labelledby="jn-tab-term">
              <div class="jn-time">
                <div class="jn-time-bar"><i></i></div>
                <div class="jn-time-labels">
                  <span><strong>{es ? 'Primera publicación' : 'First publication'}</strong></span>
                  <span><strong>{es ? '12 meses' : '12 months'}</strong>{es ? 'Garantía contractual' : 'Contractual guarantee'}</span>
                  <span><strong>{es ? '10 años' : '10 years'}</strong>{es ? 'Objetivo técnico, no garantía' : 'Technical goal, not a guarantee'}</span>
                </div>
              </div>
              <p class="jn-caption">{es ? 'Además, 15 días tras publicar para correcciones iniciales.' : 'Also, 15 days after publishing for initial corrections.'}</p>
            </div>
          </div>
          {demoIsDemo && <p class="jn-demo-note">{es ? 'Empresa de demostración, no es un negocio real.' : 'Demonstration company, not a real business.'}</p>}
        </div>
      </div>
    </div>
  </section>

  <canvas class="seam" data-a="#14297a" data-b="#070b14" aria-hidden="true" style="--a:#14297a;--b:#070b14"></canvas>

  <section class="jn-process" id="jn-process" aria-labelledby="jn-process-title">
    <div class="wrap">
      <h2 id="jn-process-title" class="display">{es ? 'Cómo te incorporas' : 'How you join'}</h2>
      <ol>
        {process.map(([title, text, who], i) => (
          <li style={`--i:${i}`}>
            <span class="jn-step-piece" aria-hidden="true"></span>
            <h3>{title}</h3>
            <p>{text}</p>
            <small>{es ? 'Actúa:' : 'Who acts:'} {who}</small>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <canvas class="seam" data-a="#070b14" data-b="#ece7db" aria-hidden="true" style="--a:#070b14;--b:#ece7db"></canvas>

  <section class="jn-offer" id="offer" data-offer={offer} aria-labelledby="jn-offer-title">
    <div class="wrap jn-offer-grid">
      <div>
        <h2 id="jn-offer-title" class="display">{offerCopy[offer].title}</h2>
        <p class="jn-offer-text">{offerCopy[offer].text}</p>
        <a class="button btn-lg jn-offer-cta" href={action.href}>{action.label}</a>
      </div>
      <div class="jn-offer-facts">
        {showsPrice && price && (
          <div class="jn-price">
            <strong>{price}</strong>
            <span>{es ? 'Precio base de la fase actual, antes de los impuestos aplicables' : 'Base price of the current release, before applicable tax'}</span>
          </div>
        )}
        {showsPrice && open !== null && (
          <div class="jn-open">
            <strong>{open}</strong>
            <span>{offer === 'premium' ? (es ? 'posiciones disponibles por solicitud' : 'positions available by application') : (es ? 'posiciones abiertas en esta fase' : 'positions open in this release')}</span>
          </div>
        )}
        {offer === 'open' || offer === 'open_no_payment' ? (
          <ul>
            <li>{es ? 'Reserva de 20 minutos: guarda capacidad, sin asignar número.' : '20-minute hold: it keeps capacity, with no number assigned.'}</li>
            <li>{es ? 'El número se asigna en orden al confirmarse el pago, y no se elige.' : 'The number is assigned in order when payment is confirmed, and cannot be chosen.'}</li>
            <li>{es ? 'Las posiciones 1 a 100 son por invitación y no están en venta.' : 'Positions 1 to 100 are by invitation and not for sale.'}</li>
            <li>{es ? 'Antes de pagar verás el total, los impuestos y las condiciones.' : 'You will see the total, tax and terms before you pay.'}</li>
          </ul>
        ) : null}
      </div>
    </div>
  </section>

  <canvas class="seam" data-a="#ece7db" data-b="#10090f" aria-hidden="true" style="--a:#ece7db;--b:#10090f"></canvas>

  <section class="jn-trust" id="terms" aria-labelledby="jn-trust-title">
    <div class="wrap">
      <h2 id="jn-trust-title" class="display">{es ? 'Condiciones de publicación' : 'Publication terms'}</h2>
      <dl class="jn-terms">
        <div>
          <dt>{es ? 'Tú apruebas' : 'You approve'}</dt>
          <dd>{es ? 'Nada se publica sin que un representante autorizado apruebe el contenido exacto.' : 'Nothing is published until an authorized representative approves the exact content.'}</dd>
        </div>
        <div>
          <dt>{es ? '12 meses garantizados' : '12 months guaranteed'}</dt>
          <dd>{es ? 'La publicación está garantizada contractualmente durante 12 meses desde la primera publicación, según los términos aceptados.' : 'Publication is contractually guaranteed for 12 months from first publication, subject to agreed terms.'}</dd>
        </div>
        <div>
          <dt>{es ? '10 años es un objetivo' : '10 years is a goal'}</dt>
          <dd>{es ? 'Conservar los perfiles 10 años es un objetivo técnico, no una promesa contractual.' : 'Keeping profiles for 10 years is a technical goal, not a contractual promise.'}</dd>
        </div>
        <div>
          <dt>{es ? 'Sin garantías en IA externa' : 'No guarantee on external AI'}</dt>
          <dd>{es ? 'THE1500 no garantiza que ChatGPT, Gemini, Claude, buscadores u otras plataformas externas indexen, recomienden o citen a ninguna empresa.' : 'THE1500 does not guarantee that ChatGPT, Gemini, Claude, search engines or other external systems will index, recommend or cite any company.'}</dd>
        </div>
        <div>
          <dt>{es ? 'No certificamos empresas' : 'We do not certify companies'}</dt>
          <dd>{es ? 'La información la declara y aprueba cada titular.' : 'Each owner declares and approves its own information.'}</dd>
        </div>
        <div>
          <dt>{es ? 'Antes de contratar' : 'Before you contract'}</dt>
          <dd>{es ? 'La entidad vendedora, los términos de servicio y la política de privacidad están en preparación. Se indicarán antes de habilitar los pagos.' : 'The selling entity, terms of service and privacy policy are in preparation. They will be stated before payment is enabled.'}</dd>
        </div>
      </dl>
    </div>
  </section>

  <canvas class="seam" data-a="#10090f" data-b="#04060b" aria-hidden="true" style="--a:#10090f;--b:#04060b"></canvas>

  <section class="finale" aria-labelledby="jn-close-title">
    <div class="finale-wall">
      <canvas class="finale-glass" aria-hidden="true"></canvas>
      <div class="finale-shade" aria-hidden="true"></div>
      <div class="finale-copy">
        <h2 id="jn-close-title">
          {offer === 'closed'
            ? es ? 'Las 1.500 ya tienen dueño.' : 'All 1,500 are taken.'
            : es ? 'Cuando se asigne la última, el muro se cierra.' : 'When the last one goes, the wall is closed.'}
        </h2>
        <div class="cta">
          <a class="button btn-lg" href={action.href}>{action.label}</a>
          {offer !== 'closed' && <a class="btn-secondary btn-lg" href={directory}>{es ? 'Ver directorio' : 'View Directory'}</a>}
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="join-data" set:html={clientJson}></script>
</main>

<noscript>
  <style is:inline>
    .jn-panel { visibility: visible; opacity: 1; grid-area: auto; }
    .finale { min-height: auto; }
    .finale-wall { position: relative; height: auto; }
  </style>
</noscript>

<script>
  import '../ui/join-page';
  import '../ui/home-scenes';
</script>
