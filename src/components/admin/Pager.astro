---
import { copy, formatNumber, type AdminLang } from './copy';
// total is null on an unfiltered list: counting it would read every row, so the pager shows the range and a next link.
interface Props { lang: AdminLang; total: number | null; hasMore: boolean; count: number; limit: number; offset: number; }
const { lang, total, hasMore, count, limit, offset } = Astro.props;
const t = copy(lang);
const to = (next: number) => { const u = new URL(Astro.url); u.searchParams.set('offset', String(next)); return `${u.pathname}${u.search}`; };
const range = count ? `${formatNumber(lang, offset + 1)}–${formatNumber(lang, offset + count)}` : '';
---
<nav class="ad-pager" aria-label={lang === 'es' ? 'Páginas' : 'Pages'}>
  <span>{total === null ? range : `${range ? `${range} / ` : ''}${formatNumber(lang, total)} ${t.results}`}</span>
  {offset > 0 && <a class="ad-btn" href={to(Math.max(0, offset - limit))}>{t.previous}</a>}
  {hasMore && <a class="ad-btn" href={to(offset + limit)}>{t.next}</a>}
</nav>
