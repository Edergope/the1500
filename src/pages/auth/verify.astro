---
import Shell from '../../layouts/Shell.astro';
import AuthFrame from '../../components/AuthFrame.astro';

// GET is intentionally side-effect-free. Email-link scanners cannot consume login tokens.
const token = Astro.url.searchParams.get('token') || '';
const valid = /^[a-f0-9]{64}$/.test(token);
const es = Astro.url.searchParams.get('lang') === 'es';
const altQuery = new URLSearchParams({ token });
if (!es) altQuery.set('lang', 'es');
const altPath = `/auth/verify?${altQuery}`;
Astro.response.headers.set('Cache-Control', 'no-store');
// Not no-referrer: browsers then send "Origin: null" on this form's POST, and the origin check refuses it.
// same-origin still keeps the token in this URL away from any other site.
Astro.response.headers.set('Referrer-Policy', 'same-origin');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<Shell title={es ? 'Confirmar acceso — THE1500' : 'Confirm sign-in — THE1500'} lang={es ? 'es' : 'en'} forceNoIndex={true} altPath={altPath} focused>
  <AuthFrame lang={es ? 'es' : 'en'}>
    <div class="auth-panel auth-confirm">
      {valid ? (
        <>
          <h1>{es ? 'Confirma tu acceso' : 'Confirm your sign-in'}</h1>
          <p class="auth-lead">
            {es
              ? 'Pulsa el botón para entrar. Este enlace funciona una vez y vence a los 15 minutos.'
              : 'Press the button to enter. This link works once and expires after 15 minutes.'}
          </p>
          <form method="POST" action="/api/v1/auth/verify">
            <input type="hidden" name="token" value={token} />
            {es && <input type="hidden" name="lang" value="es" />}
            <button type="submit" class="btn-primary">{es ? 'Confirmar acceso' : 'Confirm sign-in'}</button>
          </form>
        </>
      ) : (
        <>
          <h1>{es ? 'Este enlace no es válido' : 'This link is not valid'}</h1>
          <p class="auth-lead">
            {es ? 'Parece incompleto. Pide uno nuevo y ábrelo tal como llega en el correo.' : 'It looks incomplete. Ask for a new one and open it exactly as it arrives in the email.'}
          </p>
          <a href={es ? '/es/login' : '/login'} class="btn-primary auth-submit">{es ? 'Pedir un enlace nuevo' : 'Ask for a new link'}</a>
        </>
      )}
    </div>
  </AuthFrame>
</Shell>
