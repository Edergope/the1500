---
import { env } from 'cloudflare:workers';
import Shell from '../../layouts/Shell.astro';
import AccountWorkspace from '../../components/AccountWorkspace';
import { authenticatedPrincipal } from '../../core/identity';

let email = '';
try {
  email = (await authenticatedPrincipal(env.DB, Astro.request)).email;
} catch {
  return Astro.redirect('/es/login?required=1', 302);
}
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<Shell title="Mi cuenta — THE1500" lang="es" forceNoIndex={true}>
  <main>
    <AccountWorkspace client:load initialEmail={email} lang="es" />
  </main>
</Shell>
