---
import Shell from '../../layouts/Shell.astro';
import { env } from 'cloudflare:workers';
import { getPublicStats } from '../../core/public';
import { listPublishedCompanies, type PublicCompanyCard } from '../../core/directory';
let stats = null;
let businesses: PublicCompanyCard[] = [];
try { stats = await getPublicStats(env.DB); businesses = (await listPublishedCompanies(env.DB,{page:1})).items; } catch { /* no fake data */ }
---
<Shell title="Directorio empresarial" lang="es">
  <main>
    <div class="eyebrow">Un directorio empresarial limitado para la era de la IA</div>
    <h1>Descubre las empresas de THE1500.</h1>
    <p>Un directorio público de perfiles empresariales estructurados y autorizados, diseñado para facilitar la comprensión de sus capacidades y servicios.</p>
    {stats ? (
      <section class="panel stats" aria-label="Estadísticas del directorio">
        <div><strong>{stats.occupied}</strong><span>Posiciones asignadas</span></div>
        <div><strong>{stats.available}</strong><span>Posiciones sin asignar</span></div>
        <div><strong>{stats.published}</strong><span>Perfiles publicados</span></div>
        <div><strong>{stats.sectorsRepresented}</strong><span>Sectores representados</span></div>
      </section>
    ) : (<p class="notice">Todavía no hay estadísticas operativas verificables. No mostramos cantidades inventadas.</p>)}
    <p><a class="button" href="/es/unirse">Conocer el proyecto</a></p>
    {businesses.length ? <section class="panel" aria-label="Empresas publicadas"><h2>Empresas publicadas</h2>
      <ul>{businesses.map((business) => <li><a href={`/es/empresas/${business.slug}`}>{business.name}</a> · {business.industry} · {business.country}</li>)}</ul>
    </section> : <p class="muted">Las primeras empresas están preparando sus perfiles. Solo aparecen empresas que hayan aprobado su publicación.</p>}
  </main>
</Shell>
