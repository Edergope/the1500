---
import Shell from '../../layouts/Shell.astro';
import JoinPageView from '../../components/JoinPageView.astro';
import { env } from 'cloudflare:workers';
import { getPublicStats } from '../../core/public';

let stats = null;
try {
  stats = await getPublicStats(env.DB);
} catch {
  /* no fake data */
}
---
<Shell title="Unirse y Tramos de Membresía" lang="es">
  <JoinPageView lang="es" stats={stats} />
</Shell>
