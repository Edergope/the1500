---
import { env } from 'cloudflare:workers';
import Shell from '../../../layouts/Shell.astro';
import CompanyProfileView from '../../../components/CompanyProfileView.astro';
import { findPublicProfile, publicProfileDto } from '../../../core/directory';
import type { PublicProfile } from '../../../lib/contracts/api';

const slug = Astro.params.slug || '';
const profile = await findPublicProfile(env.DB, slug);
if (!profile) Astro.response.status = 404;

const raw = profile?.public_jsonld_es || profile?.public_jsonld || '{}';
const safe = raw
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
const dto = (profile ? publicProfileDto(profile, 'es') : null) as PublicProfile | null;
const translated = Boolean(dto && JSON.parse(profile!.canonical_json).descriptionEs);
---
<Shell
  title={profile ? `${profile.display_name} — THE1500` : 'Empresa no encontrada — THE1500'}
  lang="es"
  forceNoIndex={!profile}
>
  {profile && <script slot="head" type="application/ld+json" set:html={safe} />}
  <CompanyProfileView lang="es" dto={dto} translated={translated} rawJsonLd={raw} />
</Shell>
