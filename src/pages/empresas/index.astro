---
import { env } from 'cloudflare:workers';
import Shell from '../../layouts/Shell.astro';
import DirectoryPageView from '../../components/DirectoryPageView.astro';
import { listPublishedCompanies, listRetiredPositions } from '../../core/directory';
import { getPublicStats } from '../../core/public';
import type { DirectoryResponse } from '../../lib/contracts/api';

const rawPage = Number(Astro.url.searchParams.get('page') || '1');
const page = Number.isSafeInteger(rawPage) && rawPage >= 1 && rawPage <= 500 ? rawPage : 1;
const q = Astro.url.searchParams.get('query')?.trim() || undefined;
const rawCountry = Astro.url.searchParams.get('country')?.trim().toUpperCase() || undefined;
const country = rawCountry && /^[A-Z]{2}$/.test(rawCountry) ? rawCountry : undefined;
const industry = Astro.url.searchParams.get('industry')?.trim() || undefined;
const service = Astro.url.searchParams.get('service')?.trim() || undefined;

let result: DirectoryResponse = { items: [], total: 0, page: 1, pageSize: 24 };
let stats = null;
let retiredItems: Array<{ position: number; label: string; labelEs: string }> = [];

try {
  const [dir, s, ret] = await Promise.all([
    listPublishedCompanies(env.DB, { page, q, country, industry, service, language: 'en' }),
    getPublicStats(env.DB),
    listRetiredPositions(env.DB),
  ]);
  result = dir as DirectoryResponse;
  stats = s;
  retiredItems = ret.items;
} catch {
  result = { items: [], total: 0, page: 1, pageSize: 24 };
}
---
<Shell title="Companies Directory" lang="en">
  <DirectoryPageView
    lang="en"
    result={result}
    stats={stats}
    retiredItems={retiredItems}
    filters={{ page, q, country, industry, service }}
  />
</Shell>
