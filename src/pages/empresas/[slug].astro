---
import { env } from 'cloudflare:workers';
import Shell from '../../layouts/Shell.astro';
import CompanyProfileView from '../../components/CompanyProfileView.astro';
import { findPublicProfile, publicProfileDto } from '../../core/directory';
import type { PublicProfile } from '../../lib/contracts/api';

const slug = Astro.params.slug || '';
const profile = await findPublicProfile(env.DB, slug);
if (!profile) Astro.response.status = 404;

const dto = (profile ? publicProfileDto(profile, 'en') : null) as PublicProfile | null;
const structured = profile?.public_jsonld || '{}';
// JSON-LD embedded as script must escape script-breaking HTML characters.
const safeJson = structured
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---
<Shell
  title={profile ? `${profile.display_name} — THE1500` : 'Company not found — THE1500'}
  lang="en"
  forceNoIndex={!profile}
>
  {profile && <script slot="head" type="application/ld+json" set:html={safeJson} />}
  <CompanyProfileView lang="en" dto={dto} translated={true} rawJsonLd={structured} />
</Shell>
