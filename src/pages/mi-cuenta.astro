---
// Temporary authenticated landing. Antigravity will replace its presentation.
import { env } from 'cloudflare:workers';
import { authenticatedPrincipal } from '../core/identity';
let email='';
try { email=(await authenticatedPrincipal(env.DB,Astro.request)).email; }
catch { return Astro.redirect('/login?required=1',302); }
Astro.response.headers.set('Cache-Control','no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
---
<html lang="en"><head><meta charset="utf-8"/><title>Your account — THE1500</title></head>
<body style="max-width:44rem;margin:4rem auto;padding:1rem;font:16px system-ui">
<h1>Your THE1500 account</h1><p>Authenticated as {email}.</p>
<p>Membership data is available through the authenticated account API. Company dashboard is under development.</p>
<p><a href="/">Explore the directory</a></p></body></html>
