---
Astro.response.headers.set('Cache-Control','no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
---
<html lang="en"><head><meta charset="utf-8"/><title>Sign in — THE1500</title></head>
<body style="max-width:36rem;margin:4rem auto;padding:1rem;font:16px system-ui">
<h1>Sign in to THE1500</h1><p>Enter your business email. We will send a one-time sign-in link.</p>
<form id="login"><label>Email <input name="email" type="email" autocomplete="email" required /></label>
<button type="submit">Send sign-in link</button></form><p id="status" role="status"></p>
<script is:inline>
  document.querySelector('#login').addEventListener('submit',async e=>{
    e.preventDefault();const button=e.target.querySelector('button');button.disabled=true;
    try{
      const data=new FormData(e.target);
      const response=await fetch('/api/v1/auth/request-link',{
        method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({email:String(data.get('email')||'')})
      });
      document.querySelector('#status').textContent=response.ok?'Check your inbox for a sign-in link.':
        'Unable to send a link. Email service may not be configured.';
    }catch{document.querySelector('#status').textContent='Unable to reach the sign-in service.';}
    finally{button.disabled=false;}
  });
</script>
</body></html>
