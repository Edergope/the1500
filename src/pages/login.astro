---
import { env } from 'cloudflare:workers';
import Shell from '../layouts/Shell.astro';
import { authenticatedPrincipal } from '../core/identity';
import AuthPortal from '../components/AuthPortal';
import AuthFrame from '../components/AuthFrame.astro';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const requiredRedirect = Astro.url.searchParams.get('required') === '1';
const linkExpired = Astro.url.searchParams.get('expired') === '1';
try {
  await authenticatedPrincipal(env.DB, Astro.request);
  return Astro.redirect('/mi-cuenta', 302);
} catch {
  /* not signed in: show the form */
}
---
<Shell title="Sign in — THE1500" lang="en" forceNoIndex={true} focused>
  <AuthFrame lang="en">
    <AuthPortal client:load lang="en" requiredRedirect={requiredRedirect} linkExpired={linkExpired} />
    <noscript><p class="auth-fine">Signing in needs JavaScript. Turn it on and reload this page.</p></noscript>
  </AuthFrame>
</Shell>
