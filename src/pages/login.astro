---
import Shell from '../layouts/Shell.astro';
import AuthPortal from '../components/AuthPortal';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const requiredRedirect = Astro.url.searchParams.get('required') === '1';
---
<Shell title="Sign in — THE1500" lang="en" forceNoIndex={true}>
  <main>
    <AuthPortal client:load lang="en" requiredRedirect={requiredRedirect} />
  </main>
</Shell>
