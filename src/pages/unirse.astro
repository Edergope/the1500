---
import Shell from '../layouts/Shell.astro';
import JoinPageView from '../components/JoinPageView.astro';
import { env } from 'cloudflare:workers';
import { getPublicStats } from '../core/public';

let stats = null;
try {
  stats = await getPublicStats(env.DB);
} catch {
  /* never fabricate data */
}
---
<Shell title="Join & Membership Tiers" lang="en">
  <JoinPageView lang="en" stats={stats} />
</Shell>
