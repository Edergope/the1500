---
import Shell from '../layouts/Shell.astro';
import LandingPageView from '../components/LandingPageView.astro';
import { env } from 'cloudflare:workers';
import { getPublicStats } from '../core/public';
import { listPublishedCompanies, listRetiredPositions, type PublicCompanyCard } from '../core/directory';

let stats = null;
let businesses: PublicCompanyCard[] = [];
let totalPublished = 0;
let retiredItems: Array<{ position: number; label: string; labelEs: string }> = [];

try {
  const [s, dir, ret] = await Promise.all([
    getPublicStats(env.DB),
    listPublishedCompanies(env.DB, { page: 1, language: 'en' }),
    listRetiredPositions(env.DB),
  ]);
  stats = s;
  businesses = dir.items;
  totalPublished = dir.total;
  retiredItems = ret.items;
} catch {
  /* never fabricate data */
}
---
<Shell title="Business Directory (1,500)" lang="en">
  <LandingPageView
    lang="en"
    stats={stats}
    businesses={businesses}
    totalPublished={totalPublished}
    retiredItems={retiredItems}
  />
</Shell>
