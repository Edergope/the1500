---
interface Props { lang?: 'en' | 'es'; title: string; }
const {lang = 'en',title} = Astro.props;
const es = lang === 'es';
const indexingEnabled = import.meta.env.PUBLIC_INDEXING_ENABLED === 'true';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={indexingEnabled ? "index, follow" : "noindex, nofollow"} />
    <title>{title} · THE1500</title>
    <style is:global>
      :root {font-family:Inter,system-ui,Arial,sans-serif;color:#e9e4d7;background:#0a1422;color-scheme:dark}
      * {box-sizing:border-box}
      body{margin:0;min-height:100vh}
      a{color:#eec679}
      header,footer{padding:1.5rem clamp(1.2rem,5vw,5rem);border-bottom:1px solid #263345}
      footer{border-top:1px solid #263345;border-bottom:0;color:#b4bdc8}
      nav{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
      .brand{font-size:1.3rem;font-weight:800;letter-spacing:.08em;text-decoration:none;color:#f0cf86}
      .navlinks{display:flex;gap:1.4rem;flex-wrap:wrap}
      main{max-width:1150px;margin:0 auto;padding:clamp(2rem,6vw,6rem) 1.4rem}
      h1{font-size:clamp(2.4rem,7vw,5.8rem);font-weight:650;letter-spacing:-.055em;line-height:1.04;margin:.5em 0}
      h2{font-size:clamp(1.6rem,3.5vw,2.6rem)}
      p{line-height:1.65;color:#c6cbd5;max-width:68ch}
      .eyebrow{letter-spacing:.2em;text-transform:uppercase;color:#eec679;font-size:.78rem}
      .button{display:inline-block;padding:.95rem 1.4rem;background:#eec679;color:#0a1422;border-radius:6px;text-decoration:none;font-weight:700}
      .panel{background:#142235;border:1px solid #293b50;border-radius:12px;padding:1.5rem;margin:1.8rem 0}
      .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:.8rem}
      .stats strong{font-size:2.2rem;display:block;color:#f0cf86}
      .muted{font-size:.9rem;color:#9caabc}
      .notice{padding:1rem;border-left:2px solid #eec679;background:#162538}
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href={es ? '/es/' : '/'}>THE1500</a>
        <div class="navlinks">
          <a href={es?'/es/':'/'}>{es?'Directorio':'Directory'}</a>
          <a href={es?'/es/unirse':'/unirse'}>{es?'Unirse':'Join'}</a>
          <a href={es?'/':'/es/'} hreflang={es?'en':'es'}>{es?'English':'Español'}</a>
        </div>
      </nav>
    </header>
    <slot />
    <footer>THE1500 — {es?'Edición limitada a 1.500 empresas':'Limited to 1,500 companies'}. {es?'Sin garantías de recomendación por plataformas de IA externas.':'No guaranteed recommendations by external AI platforms.'}</footer>
  </body>
</html>
