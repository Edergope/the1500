---
interface Props {
  lang?: 'en' | 'es';
  title: string;
  description?: string;
  forceNoIndex?: boolean;
  altPath?: string;
}

const {
  lang = 'en',
  title,
  description,
  forceNoIndex = false,
  altPath,
} = Astro.props;

const es = lang === 'es';
const indexingEnabled = !forceNoIndex && import.meta.env.PUBLIC_INDEXING_ENABLED === 'true';
const currentPath = Astro.url.pathname;

function computeAltPath(path: string, isEs: boolean): string {
  if (altPath) return altPath;
  if (isEs) {
    const stripped = path.replace(/^\/es(\/|$)/, '/');
    return stripped || '/';
  } else {
    if (path === '/') return '/es/';
    if (path.startsWith('/auth/')) return path;
    return `/es${path}`;
  }
}

const switchHref = computeAltPath(currentPath, es);
const metaDesc =
  description ||
  (es
    ? 'THE1500 — Un índice privado de 1.500 empresas con perfiles públicos estructurados y datos legibles por máquinas (JSON-LD).'
    : 'THE1500 — A private index of 1,500 companies with structured public profiles and machine-readable JSON-LD.');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={indexingEnabled ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="description" content={metaDesc} />
    <title>{title.includes('THE1500') ? title : `${title} — THE1500`}</title>
    <slot name="head" />
    <style is:global>
      :root {
        --bg-canvas: #060b13;
        --bg-solid: #0a121f;
        --bg-surface: #0d1726;
        --bg-elevated: #122035;
        --bg-glass: rgba(13, 23, 38, 0.84);
        --bg-input: #08101c;
        --border-subtle: #1c2c44;
        --border-strong: #2b4162;
        --border-gold: rgba(238, 198, 121, 0.36);
        --gold-primary: #eec679;
        --gold-bright: #f7dca1;
        --gold-dim: rgba(238, 198, 121, 0.12);
        --text-primary: #f5f2eb;
        --text-secondary: #b4c0d1;
        --text-muted: #75869d;
        --emerald: #34d399;
        --emerald-bg: rgba(52, 211, 153, 0.12);
        --amber: #fbbf24;
        --amber-bg: rgba(251, 191, 36, 0.12);
        --red: #f87171;
        --red-bg: rgba(248, 113, 113, 0.12);
        --blue: #60a5fa;
        --blue-bg: rgba(96, 165, 250, 0.12);
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 14px;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        color-scheme: dark;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: var(--font-sans);
        color: var(--text-primary);
        background-color: var(--bg-canvas);
        background-image:
          radial-gradient(ellipse 85% 50% at 50% -15%, rgba(238, 198, 121, 0.08), transparent),
          radial-gradient(ellipse 60% 40% at 88% 12%, rgba(45, 85, 135, 0.12), transparent);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--gold-primary);
        text-decoration: none;
        transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
      }

      a:hover {
        color: var(--gold-bright);
      }

      /* 1. HEADER (Component #1) */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 60;
        background: rgba(6, 11, 19, 0.72);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        transition: background 0.2s ease, padding 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .site-header.scrolled {
        background: rgba(6, 11, 19, 0.96);
        border-bottom-color: var(--border-subtle);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
      }

      .nav-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0.95rem clamp(1rem, 4vw, 2.5rem);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        transition: padding 0.2s ease;
      }

      .site-header.scrolled .nav-container {
        padding-top: 0.65rem;
        padding-bottom: 0.65rem;
      }

      .brand-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        color: var(--text-primary);
        flex-shrink: 0;
      }

      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 6px;
        background: linear-gradient(135deg, rgba(238, 198, 121, 0.24), rgba(238, 198, 121, 0.05));
        border: 1px solid var(--border-gold);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--gold-primary);
      }

      .brand-name {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 0.11em;
        color: var(--text-primary);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }

      .nav-link {
        padding: 0.45rem 0.8rem;
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: 0.88rem;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
      }

      .nav-link:hover,
      .nav-link.active {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
      }

      .nav-link.active {
        color: var(--gold-primary);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-shrink: 0;
      }

      .nav-signin-btn {
        padding: 0.45rem 0.75rem;
        color: var(--text-secondary);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        border-radius: var(--radius-sm);
      }

      .nav-signin-btn:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
      }

      .lang-pill {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 600;
        padding: 0.38rem 0.6rem;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.02);
        white-space: nowrap;
      }

      .lang-pill:hover {
        border-color: var(--border-gold);
        color: var(--gold-primary);
      }

      .mobile-menu-toggle {
        display: none;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        border-radius: var(--radius-sm);
        padding: 0.45rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
      }

      .mobile-drawer-actions {
        display: none;
      }

      /* Layout Container */
      main {
        flex: 1;
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1rem, 4vw, 2.5rem);
      }

      /* Typography */
      h1, h2, h3, h4 {
        color: var(--text-primary);
        margin-top: 0;
        line-height: 1.12;
        letter-spacing: -0.032em;
      }

      h1 {
        font-size: clamp(2.15rem, 4.6vw, 3.65rem);
        font-weight: 700;
        margin-bottom: 1rem;
      }

      h2 {
        font-size: clamp(1.55rem, 2.8vw, 2.25rem);
        font-weight: 650;
        margin-bottom: 0.65rem;
      }

      h3 {
        font-size: clamp(1.1rem, 1.8vw, 1.32rem);
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      p {
        color: var(--text-secondary);
        margin-top: 0;
        margin-bottom: 1rem;
        max-width: 72ch;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold-primary);
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }

      .eyebrow::before {
        content: '';
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--gold-primary);
        box-shadow: 0 0 10px var(--gold-primary);
      }

      .mono {
        font-family: var(--font-mono);
      }

      .muted {
        font-size: 0.88rem;
        color: var(--text-muted);
      }

      /* 2 & 3. BUTTONS (Components #2 & #3) */
      .button,
      button.btn-primary,
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.72rem 1.3rem;
        background: var(--gold-primary);
        color: #060b13;
        border: 1px solid var(--gold-primary);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease;
      }

      .button:hover,
      button.btn-primary:hover,
      .btn-primary:hover {
        background: var(--gold-bright);
        border-color: var(--gold-bright);
        color: #060b13;
        transform: translateY(-1px);
      }

      .button:disabled,
      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
      }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.72rem 1.3rem;
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-primary);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease;
      }

      .btn-secondary:hover {
        border-color: var(--gold-primary);
        color: var(--gold-primary);
        background: var(--gold-dim);
      }

      .btn-sm {
        padding: 0.45rem 0.9rem;
        font-size: 0.83rem;
        white-space: nowrap;
      }

      /* HERO IMMERSIVE & MOSAIC (Section 3, Components #4, #5, #15) */
      .hero-immersive {
        position: relative;
        min-height: 86vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(1rem, 2.5vw, 2rem) 0 2rem 0;
        border-bottom: 1px solid var(--border-subtle);
        overflow: hidden;
      }

      .hero-constellation-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
        opacity: 0.85;
      }

      .hero-inner-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
        gap: clamp(1.75rem, 3.5vw, 3.25rem);
        align-items: center;
        margin: auto 0;
      }

      .hero-headline {
        font-size: clamp(2.35rem, 4.6vw, 3.85rem);
        line-height: 1.06;
        letter-spacing: -0.04em;
        margin-bottom: 1rem;
      }

      .hero-subheadline {
        font-size: clamp(1rem, 1.35vw, 1.14rem);
        color: var(--text-secondary);
        line-height: 1.65;
        margin-bottom: 1.35rem;
        max-width: 58ch;
      }

      /* Storytelling Rotator (Component #15) */
      .story-rotator {
        background: rgba(13, 23, 38, 0.9);
        border: 1px solid var(--border-gold);
        border-left: 3px solid var(--gold-primary);
        border-radius: var(--radius-md);
        padding: 0.9rem 1.15rem;
        margin-bottom: 1.5rem;
        max-width: 560px;
      }

      .story-rotator-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.35rem;
      }

      .story-step-counter {
        font-size: 0.72rem;
        color: var(--gold-primary);
        font-weight: 600;
      }

      .story-dots {
        display: flex;
        gap: 0.35rem;
      }

      .story-dot {
        width: 18px;
        height: 4px;
        border-radius: 999px;
        border: none;
        padding: 0;
        background: rgba(255, 255, 255, 0.16);
        cursor: pointer;
        transition: background 0.2s ease, width 0.2s ease;
      }

      .story-dot.active {
        background: var(--gold-primary);
        width: 28px;
      }

      .story-rotator-text {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--text-primary);
        min-height: 1.6em;
      }

      .hero-cta-group {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
      }

      .hero-cta-tertiary {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-secondary);
        padding: 0.4rem 0.5rem;
      }

      .hero-cta-tertiary:hover {
        color: var(--gold-primary);
      }

      .hero-microcopy {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      .hero-dot-sep {
        color: var(--gold-primary);
      }

      /* Interactive Mosaic Column & Slot Tiles (Component #5) */
      .hero-mosaic-col {
        background: linear-gradient(160deg, rgba(18, 32, 53, 0.86), rgba(9, 17, 30, 0.94));
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-lg);
        padding: 1.15rem;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.48);
      }

      .mosaic-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        padding-bottom: 0.8rem;
        margin-bottom: 0.85rem;
        border-bottom: 1px solid var(--border-subtle);
      }

      .mosaic-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
      }

      @keyframes tileFloatSlow {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-2.5px); }
      }

      .slot-tile {
        background: rgba(7, 13, 23, 0.78);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        padding: 0.65rem 0.7rem;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
      }

      .hero-loaded:not(.hero-reduced-motion) .slot-float-1 {
        animation: tileFloatSlow 6s ease-in-out infinite;
      }
      .hero-loaded:not(.hero-reduced-motion) .slot-float-2 {
        animation: tileFloatSlow 7.5s ease-in-out 1.2s infinite;
      }
      .hero-loaded:not(.hero-reduced-motion) .slot-float-3 {
        animation: tileFloatSlow 6.8s ease-in-out 2.4s infinite;
      }

      .slot-tile:hover,
      .slot-tile:focus,
      .slot-tile-active {
        border-color: var(--gold-primary);
        background: rgba(238, 198, 121, 0.08);
        outline: none;
      }

      .slot-tile-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.25rem;
        margin-bottom: 0.35rem;
      }

      .slot-tile-number {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--gold-primary);
      }

      .slot-tile-badge {
        font-size: 0.62rem;
        font-weight: 600;
        padding: 0.08rem 0.38rem;
        border-radius: 999px;
        white-space: nowrap;
      }

      .slot-tile-name {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.2rem;
      }

      .slot-tile-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.68rem;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
      }

      .mosaic-inspector {
        margin-top: 0.85rem;
        padding: 0.75rem 0.9rem;
        border-radius: var(--radius-sm);
        background: rgba(6, 11, 19, 0.9);
        border: 1px solid var(--border-gold);
        min-height: 54px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      /* Lower Proof Strip / Stat Chips (Component #4) */
      .hero-proof-strip {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.85rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
      }

      .stat-chip {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: rgba(13, 23, 38, 0.75);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
      }

      .stat-chip strong {
        font-size: 1.35rem;
        color: var(--gold-primary);
        font-weight: 700;
      }

      .stat-chip span {
        font-size: 0.82rem;
        color: var(--text-secondary);
        line-height: 1.3;
      }

      /* HOME SECTIONS & HEADING BLOCKS (Component #7) */
      .home-section {
        padding: clamp(2.75rem, 5vw, 4.5rem) 0;
        border-bottom: 1px solid var(--border-subtle);
      }

      .home-section-solid {
        background: var(--bg-solid);
        margin-left: calc(-1 * clamp(1rem, 4vw, 2.5rem));
        margin-right: calc(-1 * clamp(1rem, 4vw, 2.5rem));
        padding-left: clamp(1rem, 4vw, 2.5rem);
        padding-right: clamp(1rem, 4vw, 2.5rem);
      }

      .section-heading-block {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .section-subheading {
        font-size: 1.05rem;
        color: var(--text-secondary);
        margin: 0;
      }

      /* LIVE DIRECTORY PREVIEW (Section 5, Components #6, #10) */
      .mini-inventory-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.85rem;
        padding: 1rem 1.25rem;
        background: linear-gradient(90deg, rgba(238, 198, 121, 0.08), rgba(13, 23, 38, 0.9));
        border: 1px solid var(--border-gold);
        border-radius: var(--radius-md);
        margin-bottom: 1.5rem;
      }

      .mini-inv-item {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .mini-inv-label {
        font-size: 0.76rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .directory-preview-layout {
        display: grid;
        grid-template-columns: 290px 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      .preview-filters-panel {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        position: sticky;
        top: 5rem;
      }

      .preview-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
      }

      .directory-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 1.2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.15s ease, transform 0.15s ease;
      }

      .directory-card:hover {
        border-color: var(--border-gold);
        transform: translateY(-2px);
      }

      .directory-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
      }

      .directory-card-title {
        font-size: 1.12rem;
        margin: 0 0 0.25rem 0;
      }

      .directory-card-title a {
        color: var(--text-primary);
      }

      .directory-card-meta {
        display: flex;
        gap: 0.45rem;
        font-size: 0.8rem;
        color: var(--gold-primary);
        margin-bottom: 0.65rem;
      }

      .directory-card-summary {
        font-size: 0.88rem;
        color: var(--text-secondary);
        margin-bottom: 0.85rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .directory-card-quote {
        padding: 0.5rem 0.7rem;
        background: rgba(238, 198, 121, 0.06);
        border-left: 2px solid var(--gold-primary);
        border-radius: 4px;
        font-size: 0.78rem;
        color: var(--text-primary);
        margin-bottom: 0.85rem;
      }

      .directory-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-subtle);
      }

      .directory-card-cta {
        font-size: 0.84rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }

      /* HOW IT WORKS 5-STEP TIMELINE (Section 6, Component #8) */
      .steps-timeline {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
      }

      .step-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 1.25rem;
        position: relative;
      }

      .step-number-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--gold-primary);
        background: var(--gold-dim);
        border: 1px solid var(--border-gold);
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        margin-bottom: 0.75rem;
      }

      /* SCARCITY & PRICING PHASES (Section 7, Components #9, #14) */
      .scarcity-split {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 1.75rem;
        align-items: stretch;
      }

      .pricing-phases-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .pricing-phase-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .pricing-phase-card.active-phase {
        background: linear-gradient(160deg, rgba(238, 198, 121, 0.1), rgba(13, 23, 38, 0.95));
        border-color: var(--gold-primary);
        box-shadow: 0 12px 30px rgba(238, 198, 121, 0.08);
      }

      /*Panels & Generic Cards */
      .panel,
      .surface-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: clamp(1.25rem, 3vw, 2rem);
        margin: 1.5rem 0;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
      }

      .surface-card-gold {
        background: linear-gradient(165deg, rgba(238, 198, 121, 0.08), rgba(13, 23, 38, 0.94));
        border: 1px solid var(--border-gold);
      }

      .notice {
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--gold-primary);
        background: rgba(238, 198, 121, 0.07);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        color: var(--text-secondary);
        font-size: 0.92rem;
        margin: 1rem 0;
      }

      .notice-error {
        border-left-color: var(--red);
        background: var(--red-bg);
        color: #fca5a5;
      }

      .notice-success {
        border-left-color: var(--emerald);
        background: var(--emerald-bg);
        color: #a7f3d0;
      }

      /* Badges (Component #11) */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.22rem 0.6rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      .badge-gold {
        background: var(--gold-dim);
        color: var(--gold-primary);
        border: 1px solid var(--border-gold);
      }

      .badge-emerald {
        background: var(--emerald-bg);
        color: var(--emerald);
        border: 1px solid rgba(52, 211, 153, 0.3);
      }

      .badge-amber {
        background: var(--amber-bg);
        color: var(--amber);
        border: 1px solid rgba(251, 191, 36, 0.3);
      }

      .badge-red {
        background: var(--red-bg);
        color: var(--red);
        border: 1px solid rgba(248, 113, 113, 0.3);
      }

      .badge-blue {
        background: var(--blue-bg);
        color: var(--blue);
        border: 1px solid rgba(96, 165, 250, 0.3);
      }

      .badge-slate {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
      }

      /* Forms & Inputs */
      label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin-bottom: 0.35rem;
      }

      input[type='text'],
      input[type='email'],
      input[type='url'],
      input[type='search'],
      input[type='number'],
      select,
      textarea {
        width: 100%;
        padding: 0.65rem 0.85rem;
        background: var(--bg-input);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      input:focus,
      select:focus,
      textarea:focus {
        outline: none;
        border-color: var(--gold-primary);
        box-shadow: 0 0 0 3px rgba(238, 198, 121, 0.15);
      }

      /* Grid Helpers */
      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.25rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 1.25rem;
      }

      .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.15rem;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
      }

      .stat-tile {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 1.1rem;
      }

      .stat-tile strong {
        display: block;
        font-family: var(--font-mono);
        font-size: clamp(1.65rem, 3vw, 2.25rem);
        font-weight: 700;
        color: var(--gold-primary);
        line-height: 1.1;
        margin-bottom: 0.35rem;
      }

      .stat-tile span {
        font-size: 0.82rem;
        color: var(--text-secondary);
      }

      /* 10. FOOTER (Component #12) */
      .site-footer {
        margin-top: auto;
        border-top: 1px solid var(--border-subtle);
        background: #040810;
        padding: 3.5rem clamp(1rem, 4vw, 2.5rem) 2rem;
      }

      .footer-inner {
        max-width: 1280px;
        margin: 0 auto;
      }

      .footer-columns {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 2rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      }

      .footer-col-title {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-primary);
        margin-bottom: 0.9rem;
      }

      .footer-col-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        font-size: 0.88rem;
      }

      .footer-col-list a {
        color: var(--text-secondary);
      }

      .footer-col-list a:hover {
        color: var(--gold-primary);
      }

      .footer-bottom {
        padding-top: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      /* Responsive Rules (Desktop vs Mobile) */
      @media (max-width: 1024px) {
        .hero-inner-grid {
          grid-template-columns: 1fr;
        }
        .steps-timeline {
          grid-template-columns: repeat(2, 1fr);
        }
        .scarcity-split {
          grid-template-columns: 1fr;
        }
        .directory-preview-layout {
          grid-template-columns: 1fr;
        }
        .preview-filters-panel {
          position: static;
        }
        .grid-4 {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 820px) {
        .mobile-menu-toggle {
          display: inline-flex;
          align-items: center;
          gap: 0.4rem;
        }

        .nav-actions {
          display: none;
        }

        .nav-links {
          display: none;
          width: 100%;
          flex-direction: column;
          align-items: stretch;
          padding-top: 0.85rem;
          border-top: 1px solid var(--border-subtle);
          margin-top: 0.5rem;
          gap: 0.25rem;
        }

        .nav-links.open {
          display: flex;
        }

        .mobile-drawer-actions {
          display: flex;
          flex-direction: column;
          gap: 0.6rem;
          padding-top: 0.75rem;
          margin-top: 0.5rem;
          border-top: 1px solid var(--border-subtle);
        }

        .nav-container {
          flex-wrap: wrap;
        }

        .hero-immersive {
          min-height: auto;
          padding-top: 0.5rem;
        }

        .hero-cta-group {
          flex-direction: column;
          align-items: stretch;
        }

        .mosaic-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .hero-proof-strip,
        .mini-inventory-strip,
        .steps-timeline,
        .pricing-phases-grid,
        .grid-2,
        .grid-3,
        .grid-4,
        .footer-columns {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header" id="site-header">
      <nav class="nav-container" aria-label={es ? 'Navegación principal' : 'Primary navigation'}>
        <!-- Left: Logo THE1500 -->
        <a class="brand-lockup" href={es ? '/es/' : '/'}>
          <span class="brand-mark">1500</span>
          <span class="brand-name">THE1500</span>
        </a>

        <!-- Mobile Hamburger Right -->
        <button
          type="button"
          class="mobile-menu-toggle"
          id="mobile-nav-btn"
          aria-expanded="false"
          aria-controls="primary-nav-links"
        >
          <span>☰ {es ? 'Menú' : 'Menu'}</span>
        </button>

        <!-- Center / Right Nav Links -->
        <div class="nav-links" id="primary-nav-links">
          <a
            class={`nav-link ${currentPath.includes('/empresas') ? 'active' : ''}`}
            href={es ? '/es/empresas' : '/empresas'}
          >
            {es ? 'Ver Directorio' : 'View Directory'}
          </a>
          <a class="nav-link" href={es ? '/es/#how-it-works' : '/#how-it-works'}>
            {es ? 'Cómo funciona' : 'How it works'}
          </a>
          <a class="nav-link" href={es ? '/es/#pricing-phases' : '/#pricing-phases'}>
            {es ? 'Precios / Fases' : 'Pricing / Phases'}
          </a>
          <a class="nav-link" href={es ? '/es/#faq' : '/#faq'}>
            FAQ
          </a>

          <!-- Mobile Drawer CTAs -->
          <div class="mobile-drawer-actions">
            <a class="btn-primary" href={es ? '/es/unirse' : '/unirse'}>
              {es ? 'Unirse a THE1500' : 'Join THE1500'}
            </a>
            <a class="btn-secondary" href={es ? '/es/login' : '/login'}>
              {es ? 'Iniciar sesión' : 'Sign in'}
            </a>
            <a class="lang-pill" style="text-align:center" href={switchHref} hreflang={es ? 'en' : 'es'}>
              {es ? 'Switch to English (EN)' : 'Cambiar a Español (ES)'}
            </a>
          </div>
        </div>

        <!-- Desktop Right Actions: Language Switcher + Sign in (secondary text button) + Join THE1500 (primary button) -->
        <div class="nav-actions">
          <a
            class="lang-pill"
            href={switchHref}
            hreflang={es ? 'en' : 'es'}
            title={es ? 'Switch to English' : 'Cambiar a Español'}
          >
            {es ? 'EN' : 'ES'}
          </a>
          <a class="nav-signin-btn" href={es ? '/es/login' : '/login'}>
            {es ? 'Iniciar sesión' : 'Sign in'}
          </a>
          <a class="btn-primary btn-sm" href={es ? '/es/unirse' : '/unirse'}>
            {es ? 'Unirse a THE1500' : 'Join THE1500'}
          </a>
        </div>
      </nav>
    </header>

    <slot />

    <!-- 10. FOOTER (4 Columns + Bottom Line) -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-columns">
          <!-- Column 1 -->
          <div>
            <a class="brand-lockup" href={es ? '/es/' : '/'} style="margin-bottom:0.75rem">
              <span class="brand-mark">1500</span>
              <span class="brand-name">THE1500</span>
            </a>
            <p class="muted" style="margin:0.5rem 0 0.85rem 0;max-width:34ch;font-size:0.9rem">
              {es
                ? 'Un índice empresarial estructurado para la era de la IA.'
                : 'A structured business index for the AI era.'}
            </p>
            <span class="badge badge-slate mono" style="font-size:0.7rem">
              1,500 LIFETIME POSITIONS
            </span>
          </div>

          <!-- Column 2 -->
          <div>
            <div class="footer-col-title">{es ? 'Plataforma' : 'Platform'}</div>
            <ul class="footer-col-list">
              <li><a href={es ? '/es/empresas' : '/empresas'}>{es ? 'Ver Directorio' : 'View Directory'}</a></li>
              <li><a href={es ? '/es/unirse' : '/unirse'}>{es ? 'Unirse a THE1500' : 'Join THE1500'}</a></li>
              <li><a href={es ? '/es/login' : '/login'}>{es ? 'Iniciar sesión' : 'Sign in'}</a></li>
              <li><a href={es ? '/es/#faq' : '/#faq'}>FAQ</a></li>
            </ul>
          </div>

          <!-- Column 3 -->
          <div>
            <div class="footer-col-title">{es ? 'Legal y Políticas' : 'Legal & Policies'}</div>
            <ul class="footer-col-list">
              <li><a href={es ? '/es/unirse#terms' : '/unirse#terms'}>{es ? 'Términos' : 'Terms'}</a></li>
              <li><a href={es ? '/es/unirse#privacy' : '/unirse#privacy'}>{es ? 'Privacidad' : 'Privacy'}</a></li>
              <li><a href={es ? '/es/login' : '/login'}>{es ? 'Contacto' : 'Contact'}</a></li>
              <li>
                <a href={es ? '/es/#trust-proof' : '/#trust-proof'}>
                  {es ? 'Política de datos y publicación' : 'Data & publication policy'}
                </a>
              </li>
            </ul>
          </div>

          <!-- Column 4 -->
          <div>
            <div class="footer-col-title">{es ? 'Idioma y Estándares' : 'Language & Standards'}</div>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.85rem">
              <a
                class={`lang-pill ${!es ? 'badge-gold' : ''}`}
                href={es ? switchHref : currentPath}
                hreflang="en"
              >
                English (EN)
              </a>
              <a
                class={`lang-pill ${es ? 'badge-gold' : ''}`}
                href={es ? currentPath : switchHref}
                hreflang="es"
              >
                Español (ES)
              </a>
            </div>
            <div class="mono muted" style="font-size:0.74rem;line-height:1.5">
              Schema.org @graph JSON-LD<br />
              FTS5 Lexical Retrieval
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div>
            © {new Date().getFullYear()} THE1500 · {es ? 'Entidad operadora en configuración' : 'Operating entity placeholder'} ·{' '}
            {es ? 'Todos los derechos reservados.' : 'All rights reserved.'}
          </div>
          <div>
            {es
              ? 'Edición limitada a 1.500 empresas. No garantizamos inclusión ni recomendación en plataformas de IA externas.'
              : 'Limited to 1,500 companies. We do not guarantee inclusion or recommendation inside external AI platforms.'}
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const btn = document.getElementById('mobile-nav-btn');
        const links = document.getElementById('primary-nav-links');
        const header = document.getElementById('site-header');
        if (btn && links) {
          btn.addEventListener('click', function () {
            const expanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!expanded));
            links.classList.toggle('open', !expanded);
          });
        }
        if (header) {
          const onScroll = function () {
            header.classList.toggle('scrolled', window.scrollY > 20);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      })();
    </script>
  </body>
</html>
