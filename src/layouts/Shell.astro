---
import '@fontsource/libre-caslon-display/latin-400.css';
import '@fontsource/libre-caslon-display/latin-ext-400.css';
import '@fontsource-variable/hanken-grotesk/index.css';

interface Props {
  lang?: 'en' | 'es';
  title: string;
  description?: string;
  forceNoIndex?: boolean;
  altPath?: string;
}

const {
  lang = 'en',
  title,
  description,
  forceNoIndex = false,
  altPath,
} = Astro.props;

const es = lang === 'es';
// Only changes a nav label; the account page itself validates the session.
const signedIn = (Astro.request.headers.get('cookie') || '').includes('__Host-the1500_session=');
const accountHref = es ? '/es/mi-cuenta' : '/mi-cuenta';
const accountLabel = es ? 'Mi cuenta' : 'My account';
const indexingEnabled = !forceNoIndex && import.meta.env.PUBLIC_INDEXING_ENABLED === 'true';
const currentPath = Astro.url.pathname;

function computeAltPath(path: string, isEs: boolean): string {
  if (altPath) return altPath;
  if (isEs) {
    const stripped = path.replace(/^\/es(\/|$)/, '/');
    return stripped || '/';
  } else {
    if (path === '/') return '/es/';
    if (path.startsWith('/auth/')) return path;
    return `/es${path}`;
  }
}

const switchHref = computeAltPath(currentPath, es);
const metaDesc =
  description ||
  (es
    ? 'THE1500 — Un directorio público limitado a 1.500 empresas, con perfiles aprobados por sus titulares y legibles por personas y software.'
    : 'THE1500 — A public directory limited to 1,500 companies, with owner-approved profiles that both people and software can read.');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={indexingEnabled ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="description" content={metaDesc} />
    <title>{title.includes('THE1500') ? title : `${title} — THE1500`}</title>
    <slot name="head" />
    <style is:global>
      :root {
        --bg-canvas: #060b13;
        --bg-solid: #0a121f;
        --bg-surface: #0d1726;
        --bg-elevated: #122035;
        --bg-glass: rgba(13, 23, 38, 0.84);
        --bg-input: #08101c;
        --border-subtle: #1c2c44;
        --border-strong: #2b4162;
        --border-gold: rgba(238, 198, 121, 0.36);
        --gold-primary: #eec679;
        --gold-bright: #f7dca1;
        --gold-dim: rgba(238, 198, 121, 0.12);
        --text-primary: #f5f2eb;
        --text-secondary: #b4c0d1;
        --text-muted: #75869d;
        --emerald: #34d399;
        --emerald-bg: rgba(52, 211, 153, 0.12);
        --amber: #fbbf24;
        --amber-bg: rgba(251, 191, 36, 0.12);
        --red: #f87171;
        --red-bg: rgba(248, 113, 113, 0.12);
        --blue: #60a5fa;
        --blue-bg: rgba(96, 165, 250, 0.12);
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 14px;
        --font-display: 'Libre Caslon Display', Georgia, 'Times New Roman', serif;
        --font-sans: 'Hanken Grotesk Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        color-scheme: dark;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: var(--font-sans);
        color: var(--text-primary);
        background-color: var(--bg-canvas);
        background-image:
          radial-gradient(ellipse 85% 50% at 50% -15%, rgba(238, 198, 121, 0.08), transparent),
          radial-gradient(ellipse 60% 40% at 88% 12%, rgba(45, 85, 135, 0.12), transparent);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--gold-primary);
        text-decoration: none;
        transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
      }

      a:hover {
        color: var(--gold-bright);
      }

      /* 1. HEADER (Component #1) */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 60;
        background: rgba(6, 11, 19, 0.72);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        transition: background 0.2s ease, padding 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .site-header.scrolled {
        background: rgba(6, 11, 19, 0.96);
        border-bottom-color: var(--border-subtle);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
      }

      .nav-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0.95rem clamp(1rem, 4vw, 2.5rem);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        transition: padding 0.2s ease;
      }

      .brand-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        color: var(--text-primary);
        flex-shrink: 0;
      }

      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 6px;
        background: linear-gradient(135deg, rgba(238, 198, 121, 0.24), rgba(238, 198, 121, 0.05));
        border: 1px solid var(--border-gold);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--gold-primary);
      }

      .brand-name {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 0.11em;
        color: var(--text-primary);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }

      .nav-link {
        padding: 0.45rem 0.8rem;
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: 0.88rem;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
      }

      .nav-link:hover,
      .nav-link.active {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
      }

      .nav-link.active {
        color: var(--gold-primary);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-shrink: 0;
      }

      .nav-signin-btn {
        padding: 0.45rem 0.75rem;
        color: var(--text-secondary);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        border-radius: var(--radius-sm);
      }

      .nav-signin-btn:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
      }

      .lang-pill {
        font-family: var(--font-mono);
        font-size: 0.74rem;
        font-weight: 600;
        padding: 0.38rem 0.6rem;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.02);
        white-space: nowrap;
      }

      .lang-pill:hover {
        border-color: var(--border-gold);
        color: var(--gold-primary);
      }

      .mobile-menu-toggle {
        display: none;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        border-radius: var(--radius-sm);
        padding: 0.45rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
      }

      .mobile-drawer-actions {
        display: none;
      }

      /* Layout Container */
      main {
        flex: 1;
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1rem, 4vw, 2.5rem);
      }

      /* Typography */
      h1, h2, h3, h4 {
        color: var(--text-primary);
        margin-top: 0;
        line-height: 1.12;
        letter-spacing: -0.032em;
      }

      h1,
      h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-variant-numeric: lining-nums;
        letter-spacing: -0.012em;
      }

      h1 {
        font-size: clamp(2.3rem, 4.8vw, 3.9rem);
        margin-bottom: 1rem;
      }

      h2 {
        font-size: clamp(1.7rem, 3vw, 2.45rem);
        margin-bottom: 0.65rem;
      }

      h3 {
        font-size: clamp(1.1rem, 1.8vw, 1.32rem);
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      p {
        color: var(--text-secondary);
        margin-top: 0;
        margin-bottom: 1rem;
        max-width: 72ch;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold-primary);
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }

      .eyebrow::before {
        content: '';
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--gold-primary);
        box-shadow: 0 0 10px var(--gold-primary);
      }

      /* Numbers line up without looking like code. Real code keeps a monospaced face. */
      .mono {
        font-family: var(--font-sans);
        font-variant-numeric: tabular-nums;
      }

      pre,
      code {
        font-family: var(--font-mono);
      }

      .muted {
        font-size: 0.88rem;
        color: var(--text-muted);
      }

      /* 2 & 3. BUTTONS (Components #2 & #3) */
      .button,
      button.btn-primary,
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.72rem 1.3rem;
        background: var(--gold-primary);
        color: #060b13;
        border: 1px solid var(--gold-primary);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease;
      }

      .button:hover,
      button.btn-primary:hover,
      .btn-primary:hover {
        background: var(--gold-bright);
        border-color: var(--gold-bright);
        color: #060b13;
        transform: translateY(-1px);
      }

      .button:disabled,
      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
      }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.72rem 1.3rem;
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-primary);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease;
      }

      .btn-secondary:hover {
        border-color: var(--gold-primary);
        color: var(--gold-primary);
        background: var(--gold-dim);
      }

      .btn-sm {
        padding: 0.45rem 0.9rem;
        font-size: 0.83rem;
        white-space: nowrap;
      }

      /*Panels & Generic Cards */
      .panel,
      .surface-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: clamp(1.25rem, 3vw, 2rem);
        margin: 1.5rem 0;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
      }

      .surface-card-gold {
        background: linear-gradient(165deg, rgba(238, 198, 121, 0.08), rgba(13, 23, 38, 0.94));
        border: 1px solid var(--border-gold);
      }

      .notice {
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--gold-primary);
        background: rgba(238, 198, 121, 0.07);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        color: var(--text-secondary);
        font-size: 0.92rem;
        margin: 1rem 0;
      }

      .notice-error {
        border-left-color: var(--red);
        background: var(--red-bg);
        color: #fca5a5;
      }

      .notice-success {
        border-left-color: var(--emerald);
        background: var(--emerald-bg);
        color: #a7f3d0;
      }

      /* Badges (Component #11) */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.22rem 0.6rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      .badge-gold {
        background: var(--gold-dim);
        color: var(--gold-primary);
        border: 1px solid var(--border-gold);
      }

      .badge-emerald {
        background: var(--emerald-bg);
        color: var(--emerald);
        border: 1px solid rgba(52, 211, 153, 0.3);
      }

      .badge-amber {
        background: var(--amber-bg);
        color: var(--amber);
        border: 1px solid rgba(251, 191, 36, 0.3);
      }

      .badge-red {
        background: var(--red-bg);
        color: var(--red);
        border: 1px solid rgba(248, 113, 113, 0.3);
      }

      .badge-blue {
        background: var(--blue-bg);
        color: var(--blue);
        border: 1px solid rgba(96, 165, 250, 0.3);
      }

      .badge-slate {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
      }

      /* Forms & Inputs */
      label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin-bottom: 0.35rem;
      }

      input[type='text'],
      input[type='email'],
      input[type='url'],
      input[type='search'],
      input[type='number'],
      select,
      textarea {
        width: 100%;
        padding: 0.65rem 0.85rem;
        background: var(--bg-input);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      input:focus,
      select:focus,
      textarea:focus {
        outline: none;
        border-color: var(--gold-primary);
        box-shadow: 0 0 0 3px rgba(238, 198, 121, 0.15);
      }

      /* Grid Helpers */
      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.25rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 1.25rem;
      }

      .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.15rem;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
      }

      .stat-tile {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 1.1rem;
      }

      .stat-tile strong {
        display: block;
        font-family: var(--font-mono);
        font-size: clamp(1.65rem, 3vw, 2.25rem);
        font-weight: 700;
        color: var(--gold-primary);
        line-height: 1.1;
        margin-bottom: 0.35rem;
      }

      .stat-tile span {
        font-size: 0.82rem;
        color: var(--text-secondary);
      }

      /* The footer ends on the name itself, cut by the edge of the page. */
      .site-footer {
        margin-top: auto;
        background: #04060b;
        padding: clamp(2.5rem, 6vw, 5rem) 0 0;
        overflow: hidden;
        border-top: 1px solid rgba(238, 198, 121, 0.22);
      }

      .footer-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding-inline: clamp(1rem, 4vw, 3rem);
      }

      .footer-claim {
        max-width: 26ch;
        margin: 0 0 clamp(2rem, 5vw, 3.5rem);
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 3vw, 2.6rem);
        line-height: 1.12;
        color: var(--text-primary);
        text-wrap: balance;
      }

      .footer-columns {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 2rem;
      }

      .footer-col-title {
        margin: 0 0 0.8rem;
        font-family: var(--font-sans);
        font-size: 0.86rem;
        font-weight: 600;
        letter-spacing: 0;
        color: var(--gold-primary);
      }

      .footer-col-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.98rem;
      }

      .footer-col-list a {
        color: var(--text-primary);
      }

      .footer-col-list a:hover {
        color: var(--gold-primary);
      }

      .footer-col-list a[aria-current] {
        text-decoration: underline;
        text-underline-offset: 0.25em;
        text-decoration-color: var(--gold-primary);
      }

      .footer-pending {
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      .footer-note {
        margin: clamp(2rem, 4vw, 3rem) 0 0;
        max-width: 70ch;
        font-size: 0.84rem;
        line-height: 1.5;
        color: var(--text-muted);
      }

      .footer-mark {
        margin: clamp(1.5rem, 3vw, 2.5rem) 0 -0.17em;
        text-align: center;
        font-family: var(--font-display);
        font-size: 25.5vw;
        line-height: 0.86;
        letter-spacing: -0.02em;
        white-space: nowrap;
        color: var(--gold-primary);
        background: linear-gradient(rgba(238, 198, 121, 0.95), rgba(238, 198, 121, 0.25));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        user-select: none;
      }

      /* Responsive Rules (Desktop vs Mobile) */
      @media (max-width: 1024px) {
        .grid-4 {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 820px) {
        .mobile-menu-toggle {
          display: inline-flex;
          align-items: center;
          gap: 0.4rem;
        }

        .nav-actions {
          display: none;
        }

        .nav-links {
          display: none;
          width: 100%;
          flex-direction: column;
          align-items: stretch;
          padding-top: 0.85rem;
          border-top: 1px solid var(--border-subtle);
          margin-top: 0.5rem;
          gap: 0.25rem;
        }

        .nav-links.open {
          display: flex;
        }

        .mobile-drawer-actions {
          display: flex;
          flex-direction: column;
          gap: 0.6rem;
          padding-top: 0.75rem;
          margin-top: 0.5rem;
          border-top: 1px solid var(--border-subtle);
        }

        .nav-container {
          flex-wrap: wrap;
        }

        /* Long badges and tile labels wrap on a phone instead of widening the page. */
        .badge {
          white-space: normal;
          max-width: 100%;
        }

        .grid-2,
        .grid-3,
        .grid-4,
        .footer-columns {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header" id="site-header">
      <nav class="nav-container" aria-label={es ? 'Navegación principal' : 'Primary navigation'}>
        <!-- Left: Logo THE1500 -->
        <a class="brand-lockup" href={es ? '/es/' : '/'}>
          <span class="brand-mark">1500</span>
          <span class="brand-name">THE1500</span>
        </a>

        <!-- Mobile Hamburger Right -->
        <button
          type="button"
          class="mobile-menu-toggle"
          id="mobile-nav-btn"
          aria-expanded="false"
          aria-controls="primary-nav-links"
        >
          <span>☰ {es ? 'Menú' : 'Menu'}</span>
        </button>

        <!-- Center / Right Nav Links -->
        <div class="nav-links" id="primary-nav-links">
          <a
            class={`nav-link ${currentPath.includes('/empresas') ? 'active' : ''}`}
            href={es ? '/es/empresas' : '/empresas'}
          >
            {es ? 'Ver Directorio' : 'View Directory'}
          </a>
          <a class="nav-link" href={es ? '/es/#how-it-works' : '/#how-it-works'}>
            {es ? 'Cómo funciona' : 'How it works'}
          </a>
          <a class="nav-link" href={es ? '/es/#availability' : '/#availability'}>
            {es ? 'Disponibilidad' : 'Availability'}
          </a>
          <a class="nav-link" href={es ? '/es/#faq' : '/#faq'}>
            FAQ
          </a>

          <!-- Mobile Drawer CTAs -->
          <div class="mobile-drawer-actions">
            <a class="btn-primary" href={es ? '/es/unirse' : '/unirse'}>
              {es ? 'Unirse a THE1500' : 'Join THE1500'}
            </a>
            <a class="btn-secondary" href={signedIn ? accountHref : es ? '/es/login' : '/login'}>
              {signedIn ? accountLabel : es ? 'Iniciar sesión' : 'Sign in'}
            </a>
            <a class="lang-pill" style="text-align:center" href={switchHref} hreflang={es ? 'en' : 'es'}>
              {es ? 'Switch to English (EN)' : 'Cambiar a Español (ES)'}
            </a>
          </div>
        </div>

        <!-- Desktop Right Actions: Language Switcher + Sign in (secondary text button) + Join THE1500 (primary button) -->
        <div class="nav-actions">
          <a
            class="lang-pill"
            href={switchHref}
            hreflang={es ? 'en' : 'es'}
            title={es ? 'Switch to English' : 'Cambiar a Español'}
          >
            {es ? 'EN' : 'ES'}
          </a>
          <a class="nav-signin-btn" href={signedIn ? accountHref : es ? '/es/login' : '/login'}>
            {signedIn ? accountLabel : es ? 'Iniciar sesión' : 'Sign in'}
          </a>
          <a class="btn-primary btn-sm" href={es ? '/es/unirse' : '/unirse'}>
            {es ? 'Unirse a THE1500' : 'Join THE1500'}
          </a>
        </div>
      </nav>
    </header>

    <slot />

    <!-- 10. FOOTER (4 Columns + Bottom Line) -->
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-claim">
          {es ? 'Un registro público limitado a 1.500 empresas, con perfiles aprobados por sus titulares.' : 'A public register limited to 1,500 companies, with profiles approved by their owners.'}
        </p>
        <div class="footer-columns">
          <nav aria-label={es ? 'Explorar' : 'Explore'}>
            <h2 class="footer-col-title">{es ? 'Explorar' : 'Explore'}</h2>
            <ul class="footer-col-list">
              <li><a href={es ? '/es/empresas' : '/empresas'}>{es ? 'Directorio' : 'Directory'}</a></li>
              <li><a href={es ? '/es/#how-it-works' : '/#how-it-works'}>{es ? 'Cómo funciona' : 'How it works'}</a></li>
              <li><a href={es ? '/es/#faq' : '/#faq'}>{es ? 'Preguntas frecuentes' : 'Questions'}</a></li>
            </ul>
          </nav>
          <nav aria-label={es ? 'Tu cuenta' : 'Your account'}>
            <h2 class="footer-col-title">{es ? 'Tu empresa' : 'Your company'}</h2>
            <ul class="footer-col-list">
              <li><a href={es ? '/es/unirse' : '/unirse'}>{es ? 'Unirse a THE1500' : 'Join THE1500'}</a></li>
              <li><a href={signedIn ? accountHref : es ? '/es/login' : '/login'}>{signedIn ? accountLabel : es ? 'Iniciar sesión' : 'Sign in'}</a></li>
            </ul>
          </nav>
          <div>
            <h2 class="footer-col-title">Legal</h2>
            <ul class="footer-col-list">
              <li><a href={es ? '/es/unirse#terms' : '/unirse#terms'}>{es ? 'Condiciones de publicación' : 'Publication terms'}</a></li>
              <li class="footer-pending">{es ? 'Términos de servicio: en preparación' : 'Terms of service: in preparation'}</li>
              <li class="footer-pending">{es ? 'Política de privacidad: en preparación' : 'Privacy policy: in preparation'}</li>
            </ul>
          </div>
          <div>
            <h2 class="footer-col-title">{es ? 'Idioma' : 'Language'}</h2>
            <ul class="footer-col-list">
              <li><a href={es ? switchHref : currentPath} hreflang="en" aria-current={es ? undefined : 'true'}>English</a></li>
              <li><a href={es ? currentPath : switchHref} hreflang="es" aria-current={es ? 'true' : undefined}>Español</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">
          {es
            ? 'Entorno de pruebas: no se procesan cobros reales. No garantizamos inclusión ni recomendación en plataformas externas de IA.'
            : 'Test environment: no real charges are processed. We do not guarantee inclusion or recommendation on external AI platforms.'}
        </p>
      </div>
      <div class="footer-mark" aria-hidden="true">THE1500</div>
    </footer>

    <script is:inline>
      (function () {
        const btn = document.getElementById('mobile-nav-btn');
        const links = document.getElementById('primary-nav-links');
        const header = document.getElementById('site-header');
        if (btn && links) {
          btn.addEventListener('click', function () {
            const expanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!expanded));
            links.classList.toggle('open', !expanded);
          });
        }
        if (header) {
          const onScroll = function () {
            header.classList.toggle('scrolled', window.scrollY > 20);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      })();
    </script>
  </body>
</html>
