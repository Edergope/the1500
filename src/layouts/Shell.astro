---
interface Props {
  lang?: 'en' | 'es';
  title: string;
  description?: string;
  forceNoIndex?: boolean;
  altPath?: string;
}

const {
  lang = 'en',
  title,
  description,
  forceNoIndex = false,
  altPath,
} = Astro.props;

const es = lang === 'es';
const indexingEnabled = !forceNoIndex && import.meta.env.PUBLIC_INDEXING_ENABLED === 'true';
const currentPath = Astro.url.pathname;

function computeAltPath(path: string, isEs: boolean): string {
  if (altPath) return altPath;
  if (isEs) {
    const stripped = path.replace(/^\/es(\/|$)/, '/');
    return stripped || '/';
  } else {
    if (path === '/') return '/es/';
    if (path.startsWith('/auth/')) return path;
    return `/es${path}`;
  }
}

const switchHref = computeAltPath(currentPath, es);
const metaDesc =
  description ||
  (es
    ? 'THE1500 — Directorio empresarial finito de 1.500 posiciones numeradas con perfiles semánticos verificables y JSON-LD exportable.'
    : 'THE1500 — A finite B2B directory of 1,500 numbered positions with owner-approved semantic profiles and exportable JSON-LD.');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={indexingEnabled ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="description" content={metaDesc} />
    <title>{title.includes('THE1500') ? title : `${title} — THE1500`}</title>
    <slot name="head" />
    <style is:global>
      :root {
        --bg-canvas: #070d17;
        --bg-surface: #0d1726;
        --bg-elevated: #122035;
        --bg-glass: rgba(16, 28, 46, 0.82);
        --bg-input: #09111e;
        --border-subtle: #1e2f47;
        --border-strong: #2c4363;
        --border-gold: rgba(238, 198, 121, 0.34);
        --gold-primary: #eec679;
        --gold-bright: #f6da9e;
        --gold-dim: rgba(238, 198, 121, 0.12);
        --text-primary: #f4f1ea;
        --text-secondary: #b2bfd0;
        --text-muted: #76879e;
        --emerald: #34d399;
        --emerald-bg: rgba(52, 211, 153, 0.12);
        --amber: #fbbf24;
        --amber-bg: rgba(251, 191, 36, 0.12);
        --red: #f87171;
        --red-bg: rgba(248, 113, 113, 0.12);
        --blue: #60a5fa;
        --blue-bg: rgba(96, 165, 250, 0.12);
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 14px;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        color-scheme: dark;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: var(--font-sans);
        color: var(--text-primary);
        background-color: var(--bg-canvas);
        background-image:
          radial-gradient(ellipse 80% 50% at 50% -15%, rgba(238, 198, 121, 0.09), transparent),
          radial-gradient(ellipse 60% 40% at 90% 10%, rgba(45, 85, 135, 0.12), transparent);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--gold-primary);
        text-decoration: none;
        transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
      }

      a:hover {
        color: var(--gold-bright);
      }

      /* Topbar & Navigation */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(7, 13, 23, 0.88);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border-subtle);
      }

      .nav-container {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0.9rem clamp(1rem, 4vw, 2.5rem);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand-lockup {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--text-primary);
      }

      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 6px;
        background: linear-gradient(135deg, rgba(238, 198, 121, 0.22), rgba(238, 198, 121, 0.05));
        border: 1px solid var(--border-gold);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--gold-primary);
        letter-spacing: -0.03em;
      }

      .brand-name {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: var(--text-primary);
      }

      .brand-tag {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-subtle);
        color: var(--text-muted);
        white-space: nowrap;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      .nav-link {
        padding: 0.45rem 0.72rem;
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: 0.86rem;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
      }

      .nav-link:hover,
      .nav-link.active {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.05);
      }

      .nav-link.active {
        color: var(--gold-primary);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-shrink: 0;
      }

      .lang-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.4rem 0.65rem;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.02);
        white-space: nowrap;
      }

      .lang-pill:hover {
        border-color: var(--border-gold);
        color: var(--gold-primary);
      }

      .mobile-menu-toggle {
        display: none;
        background: transparent;
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        border-radius: var(--radius-sm);
        padding: 0.45rem 0.65rem;
        font-size: 0.85rem;
        cursor: pointer;
      }

      /* Layout Container */
      main {
        flex: 1;
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: clamp(1.75rem, 4vw, 3.75rem) clamp(1rem, 4vw, 2.5rem);
      }

      /* Typography */
      h1, h2, h3, h4 {
        color: var(--text-primary);
        margin-top: 0;
        line-height: 1.15;
        letter-spacing: -0.03em;
      }

      h1 {
        font-size: clamp(2.1rem, 4.8vw, 3.75rem);
        font-weight: 700;
        margin-bottom: 1rem;
      }

      h2 {
        font-size: clamp(1.4rem, 2.6vw, 2.1rem);
        font-weight: 650;
        margin-bottom: 0.75rem;
      }

      h3 {
        font-size: clamp(1.1rem, 1.8vw, 1.35rem);
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      p {
        color: var(--text-secondary);
        margin-top: 0;
        margin-bottom: 1rem;
        max-width: 72ch;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold-primary);
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 0.85rem;
      }

      .eyebrow::before {
        content: '';
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--gold-primary);
        box-shadow: 0 0 10px var(--gold-primary);
      }

      .mono {
        font-family: var(--font-mono);
      }

      .muted {
        font-size: 0.88rem;
        color: var(--text-muted);
      }

      /* Buttons */
      .button,
      button.btn-primary,
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.72rem 1.25rem;
        background: var(--gold-primary);
        color: #070d17;
        border: 1px solid var(--gold-primary);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .button:hover,
      button.btn-primary:hover,
      .btn-primary:hover {
        background: var(--gold-bright);
        border-color: var(--gold-bright);
        color: #070d17;
        transform: translateY(-1px);
      }

      .button:disabled,
      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
      }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.72rem 1.25rem;
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-primary);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .btn-secondary:hover {
        border-color: var(--gold-primary);
        color: var(--gold-primary);
        background: var(--gold-dim);
      }

      .btn-sm {
        padding: 0.45rem 0.85rem;
        font-size: 0.82rem;
        white-space: nowrap;
      }

      /* Panels & Cards */
      .panel,
      .surface-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: clamp(1.25rem, 3vw, 2rem);
        margin: 1.5rem 0;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
      }

      .surface-card-gold {
        background: linear-gradient(165deg, rgba(238, 198, 121, 0.08), rgba(13, 23, 38, 0.94));
        border: 1px solid var(--border-gold);
      }

      .notice {
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--gold-primary);
        background: rgba(238, 198, 121, 0.07);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        color: var(--text-secondary);
        font-size: 0.92rem;
        margin: 1rem 0;
      }

      .notice-error {
        border-left-color: var(--red);
        background: var(--red-bg);
        color: #fca5a5;
      }

      .notice-success {
        border-left-color: var(--emerald);
        background: var(--emerald-bg);
        color: #a7f3d0;
      }

      /* Badges */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.22rem 0.6rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      .badge-gold {
        background: var(--gold-dim);
        color: var(--gold-primary);
        border: 1px solid var(--border-gold);
      }

      .badge-emerald {
        background: var(--emerald-bg);
        color: var(--emerald);
        border: 1px solid rgba(52, 211, 153, 0.3);
      }

      .badge-amber {
        background: var(--amber-bg);
        color: var(--amber);
        border: 1px solid rgba(251, 191, 36, 0.3);
      }

      .badge-red {
        background: var(--red-bg);
        color: var(--red);
        border: 1px solid rgba(248, 113, 113, 0.3);
      }

      .badge-blue {
        background: var(--blue-bg);
        color: var(--blue);
        border: 1px solid rgba(96, 165, 250, 0.3);
      }

      .badge-slate {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
      }

      /* Forms & Inputs */
      label {
        display: block;
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin-bottom: 0.35rem;
      }

      input[type='text'],
      input[type='email'],
      input[type='url'],
      input[type='search'],
      input[type='number'],
      select,
      textarea {
        width: 100%;
        padding: 0.68rem 0.9rem;
        background: var(--bg-input);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: 0.92rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      input:focus,
      select:focus,
      textarea:focus {
        outline: none;
        border-color: var(--gold-primary);
        box-shadow: 0 0 0 3px rgba(238, 198, 121, 0.15);
      }

      /* Grid Helpers */
      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.25rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.25rem;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
      }

      .stat-tile {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 1.1rem;
      }

      .stat-tile strong {
        display: block;
        font-family: var(--font-mono);
        font-size: clamp(1.65rem, 3vw, 2.25rem);
        font-weight: 700;
        color: var(--gold-primary);
        line-height: 1.1;
        margin-bottom: 0.35rem;
      }

      .stat-tile span {
        font-size: 0.82rem;
        color: var(--text-secondary);
      }

      /* Footer */
      .site-footer {
        margin-top: auto;
        border-top: 1px solid var(--border-subtle);
        background: #050911;
        padding: 2.5rem clamp(1rem, 4vw, 2.5rem);
      }

      .footer-inner {
        max-width: 1240px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .footer-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1.5rem;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        font-size: 0.88rem;
      }

      .footer-disclaimer {
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 0.82rem;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      /* Responsive Mobile Rules */
      @media (max-width: 820px) {
        .mobile-menu-toggle {
          display: inline-flex;
          align-items: center;
          gap: 0.35rem;
        }

        .nav-links {
          display: none;
          width: 100%;
          flex-direction: column;
          align-items: stretch;
          padding-top: 0.75rem;
          border-top: 1px solid var(--border-subtle);
          margin-top: 0.5rem;
        }

        .nav-links.open {
          display: flex;
        }

        .nav-container {
          flex-wrap: wrap;
        }

        .grid-2,
        .grid-3 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-container" aria-label={es ? 'Navegación principal' : 'Primary navigation'}>
        <a class="brand-lockup" href={es ? '/es/' : '/'}>
          <span class="brand-mark">1500</span>
          <span class="brand-name">THE1500</span>
          <span class="brand-tag">{es ? 'EDICIÓN FINITA' : 'FINITE REGISTRY'}</span>
        </a>

        <button
          type="button"
          class="mobile-menu-toggle"
          id="mobile-nav-btn"
          aria-expanded="false"
          aria-controls="primary-nav-links"
        >
          <span>{es ? 'Menú' : 'Menu'}</span>
          <span aria-hidden="true">▾</span>
        </button>

        <div class="nav-links" id="primary-nav-links">
          <a
            class={`nav-link ${currentPath === '/' || currentPath === '/es/' || currentPath === '/es' ? 'active' : ''}`}
            href={es ? '/es/' : '/'}
          >
            {es ? 'Inicio' : 'Overview'}
          </a>
          <a
            class={`nav-link ${currentPath.includes('/empresas') ? 'active' : ''}`}
            href={es ? '/es/empresas' : '/empresas'}
          >
            {es ? 'Directorio (1.500)' : 'Directory (1,500)'}
          </a>
          <a
            class={`nav-link ${currentPath.includes('/empresas') ? '' : ''}`}
            href={es ? '/es/empresas#discovery-hub' : '/empresas#discovery-hub'}
          >
            {es ? 'Buscador y Asistente' : 'Search & Assistant'}
          </a>
          <a
            class={`nav-link ${currentPath.includes('/unirse') ? 'active' : ''}`}
            href={es ? '/es/unirse' : '/unirse'}
          >
            {es ? 'Unirse y Tramos' : 'Membership & Tiers'}
          </a>
          <a
            class={`nav-link ${currentPath.includes('/mi-cuenta') || currentPath.includes('/login') ? 'active' : ''}`}
            href={es ? '/es/mi-cuenta' : '/mi-cuenta'}
          >
            {es ? 'Mi cuenta' : 'Member Portal'}
          </a>
        </div>

        <div class="nav-actions">
          <a
            class="lang-pill"
            href={switchHref}
            hreflang={es ? 'en' : 'es'}
            title={es ? 'Switch to English' : 'Cambiar a Español'}
          >
            {es ? 'EN · English' : 'ES · Español'}
          </a>
          <a class="btn-primary btn-sm" href={es ? '/es/login' : '/login'}>
            {es ? 'Acceso' : 'Sign in'}
          </a>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-top">
          <div>
            <div class="brand-lockup" style="margin-bottom:0.5rem">
              <span class="brand-mark">1500</span>
              <span class="brand-name">THE1500</span>
            </div>
            <p class="muted" style="margin:0;max-width:54ch">
              {es
                ? 'Directorio empresarial finito de exactamente 1.500 posiciones numeradas con perfiles semánticos aprobados por sus titulares y datos estructurados JSON-LD.'
                : 'A finite B2B directory of exactly 1,500 numbered positions featuring owner-approved semantic business profiles and machine-readable JSON-LD.'}
            </p>
          </div>
          <div class="footer-links">
            <a href={es ? '/es/' : '/'}>{es ? 'Inicio' : 'Overview'}</a>
            <a href={es ? '/es/empresas' : '/empresas'}>{es ? 'Directorio' : 'Directory'}</a>
            <a href={es ? '/es/empresas#discovery-hub' : '/empresas#discovery-hub'}>
              {es ? 'Buscador léxico y Asistente' : 'Lexical Search & Assistant'}
            </a>
            <a href={es ? '/es/unirse' : '/unirse'}>{es ? 'Unirse' : 'Join'}</a>
            <a href={es ? '/es/login' : '/login'}>{es ? 'Iniciar sesión' : 'Sign in'}</a>
            <a href={es ? '/es/mi-cuenta' : '/mi-cuenta'}>{es ? 'Mi cuenta' : 'My Account'}</a>
          </div>
        </div>
        <div class="footer-disclaimer">
          <span>
            THE1500 — {es ? 'Edición limitada a 1.500 empresas.' : 'Limited to 1,500 companies.'}{' '}
            {es
              ? 'Sin garantías de recomendación, citación o posicionamiento por plataformas de IA o buscadores externos.'
              : 'No guaranteed recommendations, citations, or rankings by external AI platforms or search engines.'}
          </span>
          <span class="mono">Schema.org @graph · FTS5 Lexical · Grounded Citations</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const btn = document.getElementById('mobile-nav-btn');
        const links = document.getElementById('primary-nav-links');
        if (btn && links) {
          btn.addEventListener('click', function () {
            const expanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!expanded));
            links.classList.toggle('open', !expanded);
          });
        }
      })();
    </script>
  </body>
</html>
