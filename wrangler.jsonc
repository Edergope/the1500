{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the1500-staging",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {"PAYMENTS_ENABLED": "false", "AI_PROVIDER": "anthropic"},
  "r2_buckets": [{"binding": "SNAPSHOTS", "bucket_name": "the1500-staging-snapshots"}],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "the1500-staging",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "db/migrations"
  }]
}
